local function trim(s)
    return tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function getRequest()
    local candidates = {}
    local function add(fn)
        if type(fn) == "function" then table.insert(candidates, fn) end
    end
    pcall(function() add(ENV.request) end)
    pcall(function() add(ENV.http_request) end)
    pcall(function() add(ENV.httprequest) end)
    pcall(function() if ENV.syn then add(ENV.syn.request) end end)
    pcall(function() if ENV.http then add(ENV.http.request) end end)
    return candidates[1]
end

local function getHWID()
    local fallback = "RBX-" .. tostring(player.UserId) .. "-" .. tostring(game.PlaceId)
    local ok, svc = pcall(function() return game:GetService("RbxAnalyticsService") end)
    if ok and svc then
        local ok2, id = pcall(function() return svc:GetClientId() end)
        if ok2 and id and tostring(id) ~= "" then return tostring(id) end
    end
    return fallback
end

local function make(className, props, parent)
    local ok, obj = pcall(function() return Instance.new(className) end)
    if not ok or not obj then return nil end
    for k,v in pairs(props or {}) do
        pcall(function() obj[k] = v end)
    end
    if parent then obj.Parent = parent end
    return obj
end

local function corner(obj, radius)
    if not obj then return end
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

