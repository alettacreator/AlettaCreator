-- BYPASS GENERATOR - REPAIR EVENT ONLY
-- Tidak memakai SkillCheckEvent / SkillCheckResultEvent.
-- Menggunakan RemoteEvent Generator.RepairEvent dengan pola:
-- RepairEvent:FireServer(generatorModel, true)
-- =========================================================
local BypassGenerator = {
    enabled = false,
    last = 0,
    connection = nil,
}

local function getGeneratorModelsRuntime()
    local results = {}
    local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Map1")
    if not map then return results end

    local gens = map:FindFirstChild("Gens", true)
    if gens then
        for _, obj in ipairs(gens:GetChildren()) do
            if obj:IsA("Model") and obj.Name == "Generator" then
                table.insert(results, obj)
            end
        end
    end

    -- Fallback untuk runtime map yang tidak memakai Map/Gens.
    if #results == 0 then
        for _, obj in ipairs(map:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == "Generator" then
                table.insert(results, obj)
            end
        end
    end
    return results
end

local function getNearestRepairableGenerator()
    local char = character()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local best, bestDist = nil, math.huge
    for _, gen in ipairs(getGeneratorModelsRuntime()) do
        if gen and gen.Parent then
            local progress = tonumber(gen:GetAttribute("RepairProgress")) or 0
            if progress < 0.999 then
                local part = gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = (part.Position - hrp.Position).Magnitude
                    if d < bestDist then
                        best, bestDist = gen, d
                    end
                end
            end
        end
    end
    return best, bestDist
end

local function getBypassInterval()
    local mode = tostring(Values["Bypass Mode"] or "Normal")
    if mode == "Instant" then return 0.08 end
    if mode == "Perfect" then return 0.18 end
    if mode == "Legit" then return 0.45 end
    return 0.70
end

local function fireGeneratorRepair(gen)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local folder = remotes and remotes:FindFirstChild("Generator")
    local repairEvent = folder and folder:FindFirstChild("RepairEvent")
    if not (repairEvent and repairEvent:IsA("RemoteEvent")) then return false end

    -- Payload yang dipakai adalah jalur repair normal, tanpa skill-check.
    return pcall(function()
        repairEvent:FireServer(gen, true)
    end)
end

local function stopBypassGenerator()
    if BypassGenerator.connection then
        pcall(function() BypassGenerator.connection:Disconnect() end)
        BypassGenerator.connection = nil
    end
    BypassGenerator.enabled = false
end

local function startBypassGenerator()
    stopBypassGenerator()
    BypassGenerator.enabled = true
    BypassGenerator.last = 0

    BypassGenerator.connection = RunService.Heartbeat:Connect(function()
        if not BypassGenerator.enabled then return end
        if Values["Bypass Generator"] ~= true then return end

        local now = os.clock()
        local interval = getBypassInterval()
        if now - BypassGenerator.last < interval then return end

        local gen = getNearestRepairableGenerator()
        if not gen then return end

        if fireGeneratorRepair(gen) then
            BypassGenerator.last = now
        end
    end)
end

