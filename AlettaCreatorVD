local function updateKillerRange()
    local r = killerRoot()
    if not r then destroyKillerRange(); return end
    local radius = math.max(1, tonumber(Values["Hit Radius"]) or 8)
    if not KillerRuntime.rangeVisual or KillerRuntime.rangeVisual.Parent ~= r then
        destroyKillerRange()
        local a = Instance.new("CylinderHandleAdornment")
        a.Name = "AlettaKillerHitRange"
        a.Adornee = r
        a.AlwaysOnTop = true
        a.ZIndex = 6
        a.Transparency = 0.78
        a.Height = 0.08
        a.Radius = radius
        a.CFrame = CFrame.new(0, -2.85, 0)
        a.Parent = r
        KillerRuntime.rangeVisual = a
    else
        KillerRuntime.rangeVisual.Radius = radius
    end
end

local function stopKillerAttackLoop()
    disconnectList("Auto Attack (No Animation)")
