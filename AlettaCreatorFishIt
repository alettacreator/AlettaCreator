local function addToggle(parent,text,key,callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1,0,0,34)
    button.BackgroundColor3 = Theme.Panel
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = parent
    makeCorner(button,7)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(10,0)
    label.Size = UDim2.new(1,-70,1,0)
    label.Text = text
    label.TextColor3 = Theme.Text
    label.TextSize = 11
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.fromOffset(38,20)
    indicator.Position = UDim2.new(1,-48,0.5,-10)
    indicator.BackgroundColor3 = Theme.Field
    indicator.Parent = button
    makeCorner(indicator,10)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(16,16)
    dot.Position = UDim2.fromOffset(2,2)
    dot.BackgroundColor3 = Theme.Sub
    dot.Parent = indicator
    makeCorner(dot,8)

    local function update()
        local on = State[key]

        if on then
            indicator.BackgroundColor3 = Theme.Main
            dot.Position = UDim2.fromOffset(20,2)
            dot.BackgroundColor3 = Color3.new(1,1,1)
        else
            indicator.BackgroundColor3 = Theme.Field
            dot.Position = UDim2.fromOffset(2,2)
            dot.BackgroundColor3 = Theme.Sub
        end
    end

    button.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        update()

        if callback then
            pcall(callback,State[key])
        end
    end)

    update()
    return button
end

