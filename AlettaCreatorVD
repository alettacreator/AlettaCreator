-- =========================================================
-- SURVIVOR 1x CLICK ACTIONS
-- Auto Escape + Drop All Pallets.
-- Menggunakan struktur map/remotes yang terverifikasi dari project:
--   Map/Map1 -> Exit1/Exit2 -> Gate/ExitLever/Fininshline
--   Remotes.gate
--   Remotes.Pallet.PalletDropEvent
-- =========================================================
local function getRuntimeMap()
    return workspace:FindFirstChild("Map") or workspace:FindFirstChild("Map1")
end

local function getExitFolders()
    local map = getRuntimeMap()
    local exits = {}
    if not map then return exits end

    for _, name in ipairs({"Exit1", "Exit2"}) do
        local exit = map:FindFirstChild(name, true)
        if exit then
            table.insert(exits, exit)
        end
    end

    return exits
end

local function getObjectPart(obj, names)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj
    end

    for _, name in ipairs(names or {}) do
        local part = obj:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then
            return part
        end
    end

    if obj:IsA("Model") and obj.PrimaryPart and obj.PrimaryPart:IsA("BasePart") then
        return obj.PrimaryPart
    end

    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function getNearestExit()
    local r = root()
    local best, bestPart, bestDist = nil, nil, math.huge

    for _, exitFolder in ipairs(getExitFolders()) do
        local finish = exitFolder:FindFirstChild("Fininshline", true)
        local gate = exitFolder:FindFirstChild("Gate", true)
        local part = getObjectPart(finish, {"Fininshline"})
            or getObjectPart(gate, {"Box", "Frame"})

        if part then
            local d = r and (part.Position - r.Position).Magnitude or 0
            if d < bestDist then
                best = exitFolder
                bestPart = part
                bestDist = d
            end
        end
    end

    return best, bestPart, bestDist
end

local function fireGateRemote(exitFolder)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gateRemote = remotes and remotes:FindFirstChild("gate")
    if not (gateRemote and gateRemote:IsA("RemoteEvent")) then
        return false, "Remotes.gate tidak ditemukan"
    end

    local gate = exitFolder and exitFolder:FindFirstChild("Gate", true)
    if not gate then
        return false, "Gate tidak ditemukan"
    end

    -- Payload utama: model Gate. Server tetap menentukan apakah gate
    -- memang boleh dibuka/escape pada state ronde saat ini.
    local ok, err = pcall(function()
        gateRemote:FireServer(gate)
    end)

    return ok, err
end

local function autoEscapeOnce()
    local r = root()
    if not r then
        warn("[Aletta] Auto Escape: HumanoidRootPart tidak ditemukan.")
        return
    end

    local exitFolder, targetPart = getNearestExit()
    if not exitFolder or not targetPart then
        warn("[Aletta] Auto Escape: Exit1/Exit2 tidak ditemukan di runtime map.")
        return
    end

    local oldCFrame = r.CFrame

    -- Coba trigger gate lebih dulu, lalu pindahkan player ke Finishline.
    fireGateRemote(exitFolder)
    task.wait(0.12)

    local finish = exitFolder:FindFirstChild("Fininshline", true)
    local destination = getObjectPart(finish, {"Fininshline"}) or targetPart

    if destination then
        -- Sedikit di atas finish line agar tidak tersangkut di geometry.
        r.CFrame = destination.CFrame + Vector3.new(0, 2.5, 0)
        task.wait(0.18)

        -- Satu kali retry gate setelah posisi sudah di area exit.
        fireGateRemote(exitFolder)
        task.wait(0.18)
    end

    -- Jangan langsung mengembalikan posisi. Biarkan karakter tetap di
    -- Finishline agar touch/exit validation server memiliki waktu diproses.
    -- Posisi lama hanya disimpan sebagai fallback informasi; ronde yang
    -- berhasil akan dipindahkan/diakhiri oleh server.
    if not r.Parent then
        return
    end
end

local function getRuntimePallets()
    local map = getRuntimeMap()
    local results = {}
    if not map then return results end

    local palletsFolder = map:FindFirstChild("Pallets", true)
    local source = palletsFolder or map

    for _, obj in ipairs(source:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("pallet") then
            local part = obj.PrimaryPart
                or obj:FindFirstChild("HumanoidRootPart", true)
                or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then
                table.insert(results, {model = obj, part = part})
            end
        end
    end

    return results
end

local function dropAllPalletsOnce()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local palletFolder = remotes and remotes:FindFirstChild("Pallet")
    local dropEvent = palletFolder and palletFolder:FindFirstChild("PalletDropEvent")

    if not (dropEvent and dropEvent:IsA("RemoteEvent")) then
        warn("[Aletta] Drop All Pallets: Remotes.Pallet.PalletDropEvent tidak ditemukan.")
        return
    end

    local r = root()
    if not r then
        warn("[Aletta] Drop All Pallets: HumanoidRootPart tidak ditemukan.")
        return
    end

    local pallets = getRuntimePallets()
    if #pallets == 0 then
        warn("[Aletta] Drop All Pallets: tidak ada pallet runtime yang ditemukan.")
        return
    end

    local oldCFrame = r.CFrame
    local dropped = 0

    -- Server game ini memiliki remote khusus drop pallet. Kita kirim
    -- model pallet sebagai target; tidak memakai remote commit client.
    for _, data in ipairs(pallets) do
        local pallet = data.model
        local part = data.part

        if pallet and pallet.Parent and part and part.Parent then
            -- Dekatkan karakter ke pallet supaya validasi jarak server
            -- tetap memiliki konteks interaksi normal.
            pcall(function()
                r.CFrame = part.CFrame + Vector3.new(0, 2.5, 0)
            end)

            task.wait(0.04)

            local ok = pcall(function()
                dropEvent:FireServer(pallet)
            end)

            if ok then
                dropped += 1
            end

            task.wait(0.04)
        end
    end

    if r and r.Parent then
        r.CFrame = oldCFrame
    end

    print(string.format("[Aletta] Drop All Pallets selesai: %d/%d remote drop terkirim.", dropped, #pallets))
end

