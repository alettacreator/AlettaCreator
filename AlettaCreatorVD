Hooks["Flee Killer"] = function(on)
    Values["Flee Killer"] = on == true
    disconnectRuntime("fleeConnection")
    if not on then return end

    SurvivorRuntime.fleeConnection = RunService.Heartbeat:Connect(function()
        local r = root()
        if not r then return end
        local killer, dist = nearestKiller(200)
        local fleeRadius = math.max(5, tonumber(Values["Jarak Auto Flee"]) or 60)
        if not killer or dist > fleeRadius then return end
        local kr = killer.Character and killer.Character:FindFirstChild("HumanoidRootPart")
        local h = humanoid()
        if not kr or not h then return end

        local away = r.Position - kr.Position
        if away.Magnitude < 0.1 then away = -r.CFrame.LookVector end
        away = away.Unit
        local target = r.Position + away * math.min(7, math.max(2, fleeRadius * 0.08))
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {character(), killer.Character}
        local hit = workspace:Raycast(r.Position + Vector3.new(0, 1, 0), away * 8, params)
        if not hit then
            h:MoveTo(Vector3.new(target.X, r.Position.Y, target.Z))
        end
    end)
end

