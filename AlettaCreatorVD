-- saat di-upload ke GitHub.
local V14_RAW_URL = "https://raw.githubusercontent.com/alettacreator/AlettaCreator/refs/heads/main/Aletta_Creator_V14_RAW.lua"

local function httpGet(url)
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(result) == "string" and #result > 0 then
        return result
    end

    local req = getRequest()
    if type(req) == "function" then
        local rok, res = pcall(function()
            return req({Url=url, Method="GET"})
        end)
        if rok and type(res) == "table" then
            local body = res.Body or res.body
            if type(body) == "string" and #body > 0 then
                return body
            end
        end
    end
    return nil, tostring(result or "HTTP GET gagal")
end

status = status or nil
local v14Source, getErr = httpGet(V14_RAW_URL)
if type(v14Source) ~= "string" or #v14Source < 100 then
    ENV.__ALETTA_V15_RUNNING=nil
    error("Aletta V14 gagal diambil dari GitHub: " .. tostring(getErr or "file kosong"))
end

local compiler = loadstring or load
if type(compiler) ~= "function" then
    ENV.__ALETTA_V15_RUNNING=nil
    error("Executor tidak menyediakan loadstring/load.")
end

local v14Chunk, compileErr = compiler(v14Source, "AlettaCreator_V14")
if type(v14Chunk) ~= "function" then
    ENV.__ALETTA_V15_RUNNING=nil
    error("Aletta V14 compile error: " .. tostring(compileErr))
end

local runOK, runErr = xpcall(v14Chunk, function(err)
    local ok, tb = pcall(function()
        return debug.traceback(tostring(err), 2)
    end)
    return ok and tb or tostring(err)
end)

if not runOK then
    ENV.__ALETTA_V15_RUNNING=nil
    warn("[Aletta V15] V14 runtime error:\n" .. tostring(runErr))
end
