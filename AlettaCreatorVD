-- =========================================================
-- PARRY DETECTION RANGE VISUAL
-- =========================================================
-- Visual Auto Parry mengikuti referensi: hanya ring tipis di tanah,
-- tanpa disc/lingkaran penuh. Radius langsung mengikuti slider
-- Survivor > Parry Menu > Parry Radius.
local parryRangeVisual = nil
local PARRY_RING_SEGMENTS = 72
local PARRY_RING_COLOR = Color3.fromRGB(110, 245, 235)
local PARRY_RING_WIDTH = 0.10

local function destroyParryRangeVisual()
    if parryRangeVisual and parryRangeVisual.folder then
        pcall(function() parryRangeVisual.folder:Destroy() end)
    end
    parryRangeVisual = nil
end

local function getParryGroundPosition(r)
    if not r then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character()}
    params.IgnoreWater = false

    local origin = r.Position + Vector3.new(0, 2, 0)
    local result = workspace:Raycast(origin, Vector3.new(0, -20, 0), params)

    if result then
        return result.Position + Vector3.new(0, 0.055, 0)
    end

    local h = humanoid()
    local hip = h and tonumber(h.HipHeight) or 2
    return r.Position - Vector3.new(0, hip + 1.5, 0)
end

local function makeParryRing()
    local folder = Instance.new("Folder")
    folder.Name = "AlettaParryDetectionRange"
    folder.Parent = workspace

    local data = {
        folder = folder,
        points = {},
        beams = {},
    }

    for i = 1, PARRY_RING_SEGMENTS do
        local a = Instance.new("Part")
        a.Name = "PointA"
        a.Anchored = true
        a.CanCollide = false
        a.CanTouch = false
        a.CanQuery = false
        a.CastShadow = false
        a.Transparency = 1
        a.Size = Vector3.new(0.05, 0.05, 0.05)
        a.Parent = folder

        local b = Instance.new("Part")
        b.Name = "PointB"
        b.Anchored = true
        b.CanCollide = false
        b.CanTouch = false
        b.CanQuery = false
        b.CastShadow = false
        b.Transparency = 1
        b.Size = Vector3.new(0.05, 0.05, 0.05)
        b.Parent = folder

        local att0 = Instance.new("Attachment")
        att0.Parent = a
        local att1 = Instance.new("Attachment")
        att1.Parent = b

        local beam = Instance.new("Beam")
        beam.Name = "ParryRing"
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Width0 = PARRY_RING_WIDTH
        beam.Width1 = PARRY_RING_WIDTH
        beam.Color = ColorSequence.new(PARRY_RING_COLOR)
        beam.Transparency = NumberSequence.new(0.08)
        beam.LightEmission = 1
        beam.FaceCamera = true
        beam.Segments = 1
        beam.Parent = folder

        data.points[i] = {a, b}
        data.beams[i] = beam
    end

    return data
end

local function updateParryRangeVisual()
    local r = root()
    if not r then
        destroyParryRangeVisual()
        return
    end

    local radius = math.clamp(tonumber(Values["Parry Radius"]) or 13, 2, 100)
    local groundPos = getParryGroundPosition(r)
    if not groundPos then return end

    if not parryRangeVisual or not parryRangeVisual.folder or not parryRangeVisual.folder.Parent then
        destroyParryRangeVisual()
        parryRangeVisual = makeParryRing()
    end

    for i = 1, PARRY_RING_SEGMENTS do
        local pair = parryRangeVisual.points[i]
        if pair then
            local a0 = ((i - 1) / PARRY_RING_SEGMENTS) * math.pi * 2
            local a1 = (i / PARRY_RING_SEGMENTS) * math.pi * 2

            pair[1].Position = groundPos + Vector3.new(
                math.cos(a0) * radius,
                0,
                math.sin(a0) * radius
            )

            pair[2].Position = groundPos + Vector3.new(
                math.cos(a1) * radius,
                0,
                math.sin(a1) * radius
            )
        end
    end
end

local function setParryRangeVisual(enabled)
    if not enabled then
        destroyParryRangeVisual()
        return
    end
    updateParryRangeVisual()
end

