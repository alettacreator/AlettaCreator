-- KILLER FEATURE RUNTIME
-- Dibangun dari remote/object yang benar-benar ditemukan pada project.
-- Remote attack/hook/break tersedia, tetapi payload server tidak tersimpan
-- pada rbxlx; fitur client-side tidak memalsukan payload yang tidak terverifikasi.
-- =========================================================
local KillerRuntime = {
    walkOriginal = nil,
    cameraMode = "Default",
    rangeVisual = nil,
    attackConn = nil,
    aimConn = nil,
    collisionConn = nil,
    blindConn = nil,
    lastAttack = 0,
    mask = "Default",
}

local function killerRoot()
    return root()
end

local function nearestSurvivor(maxDistance)
    local r = killerRoot()
    if not r then return nil, math.huge end
    local best, bestDist = nil, maxDistance or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local role = detectESPExplicitRole(p)
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
            if h and pr and h.Health > 0 and role == "Survivor" then
                local d = (pr.Position - r.Position).Magnitude
                if d <= bestDist then
                    best, bestDist = p, d
                end
            end
        end
    end
    return best, bestDist
end

local function getAttackRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local attacks = remotes and remotes:FindFirstChild("Attacks")
    local remote = attacks and attacks:FindFirstChild(name)
    if remote and remote:IsA("RemoteEvent") then return remote end
    return nil
end

local function getEquippedAttackTool(mode)
    local c = character()
    if not c then return nil end
    local wanted = tostring(mode or Values["Attack Mode"] or "Basic Attack")
    local names = wanted == "Lunge"
        and {"Lunge", "BasicAttack", "Basic Attack"}
        or {"BasicAttack", "Basic Attack", "Lunge"}
    for _, n in ipairs(names) do
        local tool = c:FindFirstChild(n)
        if tool and tool:IsA("Tool") then return tool end
    end
    for _, obj in ipairs(c:GetChildren()) do
        if obj:IsA("Tool") and (obj.Name:lower():find("attack") or obj.Name:lower():find("lunge")) then
            return obj
        end
    end
    return nil
end

local function attackOnce(mode)
    local tool = getEquippedAttackTool(mode)
    if tool then
        local ok = pcall(function() tool:Activate() end)
        if ok then return true end
    end
    -- Remote names are verified, but their server payload is not present in
    -- the supplied project source, so no guessed FireServer arguments are sent.
    local remote = getAttackRemote(mode == "Lunge" and "Lunge" or "BasicAttack")
    if remote then
        print("[Aletta] Attack remote ditemukan:", remote:GetFullName(), "payload server belum terverifikasi")
    end
    return false
end

