local busy=false
local verified=false

local function verifyKey()
    if busy then return end
    local key=trim(input.Text)
    if key=="" then status.Text="Masukkan key terlebih dahulu."; return end

    local req=getRequest()
    if type(req)~="function" then
        status.Text="HTTP request tidak tersedia pada executor.\nGunakan executor yang menyediakan request/http_request."
        return
    end

    busy=true
    verify.Active=false
    verify.Text="CHECKING..."
    status.Text="Menghubungkan ke Aletta API..."

    local body=HttpService:JSONEncode({
        key=key,
        userId=tostring(player.UserId),
        hwid=getHWID()
    })

    local ok,res=pcall(function()
        return req({
            Url=API_BASE.."/api/verify",
            Method="POST",
            Headers={ ["Content-Type"]="application/json" },
            Body=body
        })
    end)

    if not ok or type(res)~="table" then
        status.Text="Request API gagal.\n"..tostring(res or "unknown error")
        verify.Text="VERIFY KEY"; verify.Active=true; busy=false
        return
    end

    local raw=res.Body or res.body or ""
    local jsonOK,data=pcall(function() return HttpService:JSONDecode(raw) end)
    if not jsonOK or type(data)~="table" then
        status.Text="Response API tidak valid.\nHTTP: "..tostring(res.StatusCode or res.status_code or "?")
        verify.Text="VERIFY KEY"; verify.Active=true; busy=false
        return
    end

    if data.success==true then
        verified=true
        ENV.__ALETTA_V15_KEY_VALID=true
        ENV.__ALETTA_V15_KEY_TYPE=tostring(data.type or "UNKNOWN")
        ENV.__ALETTA_V15_KEY_EXPIRES=data.expiresAt
        status.Text="KEY VALID\nType: "..tostring(data.type or "UNKNOWN")
        task.wait(0.35)
        if gate then gate:Destroy() end
    else
        local e=tostring(data.error or "VERIFY_FAILED")
        local map={
            KEY_NOT_FOUND="Key tidak ditemukan.",
            KEY_REVOKED="Key sudah direvoke.",
            KEY_EXPIRED="Key sudah expired.",
            USER_MISMATCH="Key terikat ke UserId lain.",
            HWID_MISMATCH="Key terikat ke perangkat lain.",
            MISSING_FIELDS="Data verifikasi tidak lengkap."
        }
        status.Text=map[e] or ("Verifikasi gagal: "..e)
        verify.Text="VERIFY KEY"; verify.Active=true; busy=false
    end
end

