local function paintRainbowTheme()
    local hue = (os.clock() * 0.10) % 1
    local main = Color3.fromHSV(hue, 0.72, 0.72)
    local accent = Color3.fromHSV((hue + 0.16) % 1, 0.88, 1)
    local outline = Color3.fromHSV((hue + 0.50) % 1, 0.45, 1)
    local field = main:Lerp(Color3.new(0,0,0), 0.48)
    local panel = main:Lerp(Color3.new(0,0,0), 0.66)

    ACCENT = accent
    PANEL = panel
    FIELD = field

    if window and window.Parent then
        -- Keep the Rainbow asset as the background; only the GUI colors animate.
        if bgImg then bgImg.Image = "rbxassetid://89672943739008" end
        if bgDark then bgDark.BackgroundColor3 = panel end
        window.BackgroundColor3 = Color3.new(0,0,0)
    end

    for _, obj in ipairs(window:GetDescendants()) do
        if obj:IsA("UIStroke") then
            obj.Color = outline
        elseif obj:IsA("UIGradient") and obj.Parent and obj.Parent:IsA("UIStroke") then
            obj.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(hue,0.90,1)),
                ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hue+0.33)%1,0.90,1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV((hue+0.66)%1,0.90,1))
            })
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.TextColor3 = Color3.fromRGB(255,255,255)
        elseif obj:IsA("TextButton") or obj:IsA("ImageButton") then
            obj.BackgroundColor3 = field
        elseif obj:IsA("ScrollingFrame") then
            obj.BackgroundColor3 = panel
        elseif obj:IsA("Frame") and obj.BackgroundTransparency < 1 then
            local n = string.lower(obj.Name or "")
            local isBg = obj == bgImg or obj == bgDark or obj == headerBar or obj == headerBarShade
            if not isBg then
                if n:find("header") or n:find("top") then
                    obj.BackgroundColor3 = panel
                else
                    obj.BackgroundColor3 = field
                end
            end
        end
    end

    if wStroke then wStroke.Color = outline end
    if headerStroke then headerStroke.Color = outline end
    if iconStroke then iconStroke.Color = outline end
end

