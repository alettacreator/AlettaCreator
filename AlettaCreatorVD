local function normalizeESPText(value)
    if value == nil then return nil end
    local text = tostring(value):lower():gsub("%s+", "")
    if text:find("killer", 1, true) then return "Killer" end
    if text:find("survivor", 1, true) then return "Survivor" end
    if text:find("zombie", 1, true) then return "Zombie" end
    if text:find("scp", 1, true) then return "SCP" end
    return nil
end

-- Role detector yang lebih toleran. Build sebelumnya hanya membaca
-- Attribute("Role"), sehingga ESP mati jika game menyimpan role di
-- RoleName/Team/StringValue atau hanya Team player.
local function detectESPExplicitRole(targetPlayer)
    if not targetPlayer then return nil end
    local c = targetPlayer.Character

    local candidates = {
        c and c:GetAttribute("Role"),
        c and c:GetAttribute("RoleName"),
        c and c:GetAttribute("Team"),
        targetPlayer:GetAttribute("Role"),
        targetPlayer:GetAttribute("RoleName"),
        targetPlayer:GetAttribute("Team"),
        targetPlayer.Team and targetPlayer.Team.Name
    }

    for _, value in ipairs(candidates) do
        local role = normalizeESPText(value)
        if role then return role end
    end

    -- Beberapa build menyimpan role sebagai StringValue/Value object.
    local containers = {targetPlayer, c}
    for _, container in ipairs(containers) do
        if container then
            for _, name in ipairs({"Role", "RoleName", "Team"}) do
                local valueObject = container:FindFirstChild(name)
                if valueObject and valueObject:IsA("ValueBase") then
                    local role = normalizeESPText(valueObject.Value)
                    if role then return role end
                end
            end
        end
    end

    return nil
end

local function hasMatchRole(targetPlayer)
    local explicit = detectESPExplicitRole(targetPlayer)
    if explicit then return true end

    -- Jika role belum tereplikasi sebagai attribute, player dengan character
    -- aktif tetap dapat menjadi survivor candidate. Killer akan dicari lewat
    -- detector di atas saat addCharacterESP().
    local c = targetPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = c and c:FindFirstChild("HumanoidRootPart")
    return h ~= nil and r ~= nil and h.Health > 0
end

local function roleOf(targetPlayer)
    local explicit = detectESPExplicitRole(targetPlayer)
    if explicit then return explicit end

    -- Dalam match VD, player lain yang tidak terdeteksi sebagai Killer
    -- diperlakukan sebagai Survivor. Ini mencegah ESP hilang hanya karena
    -- attribute Role belum direplikasi ke client.
    return "Survivor"
end

local function espColor(role)
    if role == "Killer" then
        return Color3.fromRGB(255, 60, 60)
    elseif role == "Survivor" then
        return Color3.fromRGB(70, 255, 100)
    end
    return espColorMap[role] or ACCENT
end

local function distanceAllowed(part)
    local myRoot = root()
    if not myRoot or not part then return true end
    local maxDistance = tonumber(Values["ESP Distance"]) or 600
    if maxDistance <= 0 then return true end
    return (myRoot.Position - part.Position).Magnitude <= maxDistance
end

local function espTransparency()
    local value = tonumber(Values["ESP Transparency"]) or 2
    return math.clamp(value / 11, 0, 1)
end

local function addCharacterESP(targetPlayer)
    if not isMatchESPAllowed() then return end
    if targetPlayer == player then return end

    local c = targetPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local targetRoot = c and c:FindFirstChild("HumanoidRootPart")
    local role = roleOf(targetPlayer)

    -- Player lobby tanpa Role tidak boleh muncul.
    if not c or not h or not targetRoot or h.Health <= 0 or not role then return end
    if not distanceAllowed(targetRoot) then return end

    -- Name/Distance ESP hanya untuk Killer dan Survivor.
    -- Zombie/SCP tetap diberi highlight ungu, tetapi tanpa Name/Distance.
    local isZombie = role == "Zombie" or role == "Zombie Dummy" or role == "SCP"
    if role ~= "Killer" and role ~= "Survivor" and not isZombie then
        return
    end
    if role == "Killer" and not Values["ESP Killer"] then return end
    if role == "Survivor" and not Values["ESP Survivor"] then return end
    if isZombie and Values["Target SCP / Zombie"] == false then return end

    local color = isZombie and Color3.fromRGB(190, 70, 255) or espColor(role)
    local transparency = espTransparency()

    local highlight = Instance.new("Highlight")
    highlight.Adornee = c
    highlight.FillTransparency = math.max(0.82, transparency)
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = color
    highlight.FillColor = color
    highlight.Parent = espFolder

    if not isZombie and (Values["Show Name"]
        or Values["Show Distance"]
        or Values["Show Health"]) then

        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = targetRoot
        billboard.Size = UDim2.fromOffset(180, 45)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = espGui

        local text = Instance.new("TextLabel")
        text.BackgroundTransparency = 1
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.GothamBold
        text.TextSize = 12
        text.TextColor3 = color
        text.TextStrokeTransparency = 0.2
        text.Parent = billboard

        local parts = {}
        if Values["Show Name"] then table.insert(parts, targetPlayer.Name) end
        if Values["Show Health"] then
            table.insert(parts, "[" .. math.floor(h.Health) .. " HP]")
        end
        if Values["Show Distance"] then
            local myRoot = root()
            if myRoot then
                table.insert(parts, "[" .. math.floor(
                    (myRoot.Position - targetRoot.Position).Magnitude
                ) .. " M]")
            end
        end
        text.Text = table.concat(parts, " ")
    end
end

local function objectKind(object)
    local name = object.Name:lower()

    if name:find("generator") then
        return "Generator"
    elseif name:find("gate") or name:find("exit") then
        return "Gate"
    elseif name:find("hook") or name:find("scourge") then
        return "Hook"
    elseif name:find("pallet") then
        return "Pallet"
    elseif name:find("window") or name:find("vault") then
        return "Window"
    end

    return nil
end

local function gateDisplayName(object)
    local name = object.Name:lower()
    if name:find("gate%s*1") or name:find("gate_1") or name:find("gate%-1") then
        return "Gate 1"
    elseif name:find("gate%s*2") or name:find("gate_2") or name:find("gate%-2") then
        return "Gate 2"
    end
    return "Gate"
end

local function addObjectESP(object, kind, gateIndex)
    if not isMatchESPAllowed() then return end

    if kind == "Generator" and not Values["ESP Generator"] then return end
    if kind == "Gate" and not Values["ESP Gate"] then return end
    if kind == "Hook" and not Values["ESP Hook"] then return end
    if kind == "Pallet" and not Values["ESP Pallet"] then return end
    if kind == "Window" and not Values["ESP Window / Vault"] then return end

    local part = object:IsA("BasePart")
        and object
        or object:FindFirstChildWhichIsA("BasePart", true)
    if not part or not distanceAllowed(part) then return end

    -- Warna object ESP ditetapkan sesuai permintaan:
    -- Generator = biru, Window/Vault = kuning, Pallet = kuning,
    -- Hook = merah, Gate 1/2 = putih.
    local color = espColorMap[kind] or ACCENT
    local transparency = espTransparency()

    local highlight = Instance.new("Highlight")
    highlight.Adornee = object
    highlight.FillTransparency = math.max(0.82, transparency)
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = color
    highlight.FillColor = color
    highlight.Parent = espFolder

    -- Object ESP tidak menampilkan Name/Distance.
    -- Name/Distance hanya dipakai oleh addCharacterESP untuk Killer/Survivor.
end

rebuildESP = function()
    clearESP()

    if not Values["Enable ESP"] then return end
    if not isMatchESPAllowed() then return end

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        addCharacterESP(targetPlayer)
    end

    local gateIndex = 0
    for _, object in ipairs(workspace:GetDescendants()) do
        local kind = objectKind(object)
        if kind and (object:IsA("Model") or object:IsA("BasePart")) then
            if kind == "Gate" then
                gateIndex += 1
                addObjectESP(object, kind, gateIndex)
            else
                addObjectESP(object, kind)
            end
        end
    end
end

Hooks["Enable ESP"] = function(on)
    disconnectList("Enable ESP")
    if on then
        bindMatchSignals()

        -- Jangan menunggu BindableEvent Start jika script di-load setelah
        -- ronde sudah berjalan. Jika ada player aktif + map object, izinkan ESP.
        if not espMatchActive and not espWaitingForStart and matchHeuristic() then
            espMatchActive = true
        end

        rebuildESP()

        local lastRebuild = 0
        FeatureManager:Connect("Enable ESP", RunService.Heartbeat, function()
            local now = os.clock()
            if now - lastRebuild >= 0.50 then
                lastRebuild = now
                if not espMatchActive and not espWaitingForStart and matchHeuristic() then
                    espMatchActive = true
                end
                rebuildESP()
            end
        end)
    else
        clearESP()
    end
end

