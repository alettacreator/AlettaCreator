local function aimPartFor(characterModel)
    local targetMode = Values["Target Aim"] or "Torso"
    if targetMode == "Head" then
        return characterModel:FindFirstChild("Head") or characterModel:FindFirstChild("HumanoidRootPart")
    elseif targetMode == "Legs" then
        return characterModel:FindFirstChild("LeftFoot")
            or characterModel:FindFirstChild("LeftLowerLeg")
            or characterModel:FindFirstChild("HumanoidRootPart")
    end
    return characterModel:FindFirstChild("UpperTorso")
        or characterModel:FindFirstChild("Torso")
        or characterModel:FindFirstChild("HumanoidRootPart")
end

local function hasLineOfSight(origin, part, targetCharacter)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character(), targetCharacter}
    local result = workspace:Raycast(origin, part.Position - origin, params)
    return result == nil
end

local function isKnocked(targetCharacter, targetPlayer)
    if Values["Block Aim Knocked"] ~= true then return false end
    local names = {"Knocked", "Downed", "IsKnocked", "DBNO", "InjuredDown", "Unconscious"}
    for _, n in ipairs(names) do
        local a = targetCharacter and targetCharacter:GetAttribute(n)
        local b = targetPlayer and targetPlayer:GetAttribute(n)
        if a == true or b == true then return true end
        if tostring(a):lower() == "knocked" or tostring(b):lower() == "knocked" then return true end
    end
    local h = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
    if h then
        local st = tostring(h:GetState())
        if st:find("PlatformStanding") or st:find("Physics") then
            -- Do not treat every physics state as knocked; only reject if an explicit marker exists.
        end
    end
    return false
end

local function detectAimRole(targetPlayer)
    if not targetPlayer then return nil end
    local c = targetPlayer.Character
    local function norm(v)
        if v == nil then return nil end
        local t = tostring(v):lower():gsub("%s+", "")
        if t:find("killer",1,true) then return "Killer" end
        if t:find("survivor",1,true) then return "Survivor" end
        if t:find("zombie",1,true) then return "Zombie" end
        if t:find("scp",1,true) then return "SCP" end
        return nil
    end
    local candidates = {
        c and c:GetAttribute("Role"), c and c:GetAttribute("RoleName"), c and c:GetAttribute("Team"),
        targetPlayer:GetAttribute("Role"), targetPlayer:GetAttribute("RoleName"), targetPlayer:GetAttribute("Team"),
        targetPlayer.Team and targetPlayer.Team.Name
    }
    for _, v in ipairs(candidates) do
        local r = norm(v)
        if r then return r end
    end
    return nil
end

local function getAimTarget()
    camera = workspace.CurrentCamera or camera
    local myRoot = root()
    if not camera or not myRoot then return nil end

    local maxPixels = math.clamp(tonumber(Values["Pistol FOV Radius"]) or 120, 10, 600)
    if Values["Pistol FOV Mode"] ~= true and Values["Enable Aimbot"] ~= true then
        maxPixels = math.max(maxPixels, 120)
    end
    local maxWorldDistance = 500
    local targetMode = Values["Pistol Target"] or "Killer"
    local bestPart, bestPlayer, bestScore = nil, nil, math.huge
    local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local tc = targetPlayer.Character
            local th = tc and tc:FindFirstChildOfClass("Humanoid")
            local tr = tc and tc:FindFirstChild("HumanoidRootPart")
            if tc and th and tr and th.Health > 0 and not isKnocked(tc, targetPlayer) then
                local role = detectAimRole(targetPlayer)
                local validRole = (targetMode == "Killer" and role == "Killer")
                    or (targetMode == "Survivor" and role == "Survivor")
                    or (targetMode == "Zombie" and (role == "Zombie" or role == "SCP"))
                if validRole then
                    local part = aimPartFor(tc)
                    if part then
                        local distance = (tr.Position - myRoot.Position).Magnitude
                        local screen, onScreen = camera:WorldToViewportPoint(part.Position)
                        if onScreen and screen.Z > 0 and distance <= maxWorldDistance then
                            local score = (Vector2.new(screen.X,screen.Y)-center).Magnitude
                            if score <= maxPixels and score < bestScore and hasLineOfSight(camera.CFrame.Position,part,tc) then
                                bestPart, bestPlayer, bestScore = part, targetPlayer, score
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestPlayer, bestScore
end

local function predictedPosition(part, smart, leadOverride)
    if not part then return nil end
    local velocity = part.AssemblyLinearVelocity or Vector3.zero
    local lead = leadOverride
    if lead == nil then
        lead = math.clamp((tonumber(Values["Prediction"]) or 35) / 100, 0, 1.5)
    end
    if smart then
        local rootPart = part.Parent and part.Parent:FindFirstChild("HumanoidRootPart")
        local origin = rootPart and rootPart.Position or (camera and camera.CFrame.Position) or part.Position
        local speed = math.max((camera and (part.Position-origin).Magnitude or 0) / math.max(lead,0.05), 1)
        lead = math.clamp((part.Position-origin).Magnitude / speed * (tonumber(Values["Smart Predict Lead"]) or 17) / 100, 0, 1.5)
    end
    return part.Position + velocity * lead
end

local function refreshAimLock()
    local part, plr, score = getAimTarget()
    AimLock.target, AimLock.player, AimLock.score = part, plr, score or math.huge
    AimLock.position = part and predictedPosition(part, false) or nil
    return part, plr
end

function AimLock.GetTarget()
    local target = AimLock.target
    if target and target.Parent then
        local h = target.Parent:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 and not isKnocked(target.Parent, AimLock.player) then return target end
    end
    return nil
end
