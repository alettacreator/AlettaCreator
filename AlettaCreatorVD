local function applyConfigVisuals()
    local oldPanel = PANEL
    local oldField = FIELD
    local oldAccent = ACCENT
    local oldBG = BG

    local mainName = Values["Main Color Value"] or "Purple"
    local accentName = Values["Accent Color Value"] or "Purple"
    local outlineName = Values["Outline Color Value"] or "White"
    local fontName = Values["Font Color Value"] or "White"
    local bgName = Values["Background Color Value"] or "Dark Purple"

    local selectedTheme = themePresets[Values["Theme List"] or "PURPLE"]
    local mainColor = (selectedTheme and selectedTheme.main) or colorPresets[mainName] or ACCENT
    local accentColor = (selectedTheme and selectedTheme.accent) or colorPresets[accentName] or ACCENT
    local outlineColor = (selectedTheme and selectedTheme.outline) or colorPresets[outlineName] or Color3.new(1,1,1)
    local fontColor = (selectedTheme and selectedTheme.font) or colorPresets[fontName] or TEXT
    local bgColor = (selectedTheme and selectedTheme.background) or colorPresets[bgName] or BG

    if Values["Main Color"] ~= false then
        ACCENT = mainColor
        PANEL = mainColor:Lerp(Color3.new(0,0,0), 0.55)
        FIELD = mainColor:Lerp(Color3.new(0,0,0), 0.25)
    end
    if Values["Accent Color"] ~= false then
        ACCENT = accentColor
    end
    if Values["Background Color"] ~= false then
        BG = bgColor
    end

    window.BackgroundColor3 = BG
    wStroke.Color = Values["Outline Color"] == false and Color3.new(1,1,1) or outlineColor
    if bgDark then bgDark.BackgroundColor3 = BG:Lerp(Color3.new(0,0,0), 0.65) end
    if logoBadge then
        local stroke = logoBadge:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Color = ACCENT end
    end
    if iconStroke then iconStroke.Color = outlineColor end

    local selectedThemeName = Values["Theme List"] or "PURPLE"
    local selectedTheme = themePresets[selectedThemeName]
    if selectedTheme and selectedTheme.asset then
        -- header notice is text-only; no image asset
        icon.Image = selectedTheme.asset
    else
        -- header notice is text-only; no image asset
        icon.Image = LOGO_ID
    end

    for _, obj in ipairs(window:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            if obj.TextColor3 == TEXT or obj.TextColor3 == Color3.fromRGB(220,220,220) then
                obj.TextColor3 = fontColor
            end
        end
    end

    -- Repaint fixed/hard-coded GUI surfaces so theme changes are global.
    for _, obj in ipairs(window:GetDescendants()) do
        if obj:IsA("GuiObject") and obj.BackgroundTransparency < 1 then
            local n = string.lower(obj.Name or "")
            local isBackground = obj == bgImg or obj == bgDark or obj == headerBar or obj == headerBarShade
            if not isBackground then
                local c = obj.BackgroundColor3
                local maxc = math.max(c.R, c.G, c.B)
                local minc = math.min(c.R, c.G, c.B)
                local sat = maxc > 0 and ((maxc - minc) / maxc) or 0
                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                    -- Controls use the theme panel by default; active states are recolored by their handlers.
                    obj.BackgroundColor3 = PANEL
                elseif obj:IsA("ScrollingFrame") then
                    obj.BackgroundColor3 = PANEL
                elseif obj:IsA("Frame") then
                    -- Keep very bright accent-like surfaces as accents; dark neutral surfaces become themed panels.
                    if sat > 0.30 and maxc > 0.35 then
                        obj.BackgroundColor3 = ACCENT
                    elseif maxc < 0.35 or sat < 0.18 then
                        obj.BackgroundColor3 = FIELD
                    else
                        obj.BackgroundColor3 = PANEL
                    end
                end
            end
        end
    end

    -- Force every visible stroke/gradient in the GUI to follow the selected theme.
    for _, obj in ipairs(window:GetDescendants()) do
        if obj:IsA("UIStroke") then
            obj.Color = outlineColor
        elseif obj:IsA("UIGradient") and obj.Parent and obj.Parent:IsA("UIStroke") then
            obj.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, outlineColor),
                ColorSequenceKeypoint.new(0.5, accentColor),
                ColorSequenceKeypoint.new(1, mainColor)
            })
        end
    end
    headerStroke.Color = outlineColor
    wStroke.Color = outlineColor

    local face = fontMap[Values["Font Face"] or "Roboto"] or Enum.Font.Gotham
    for _, obj in ipairs(window:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.Font = face
        end
    end

    for _, obj in ipairs(cornerObjects) do
        if obj and obj.Parent then
            obj.CornerRadius = UDim.new(0, math.clamp(tonumber(Values["Corner Radius"]) or 10, 0, 20))
        end
    end

    for _, obj in ipairs(window:GetDescendants()) do
        if obj:IsA("GuiObject") then
            -- Recolor existing panels/fields created with the previous theme.
            if obj.BackgroundTransparency < 1 then
                if obj.BackgroundColor3 == oldPanel then
                    obj.BackgroundColor3 = PANEL
                elseif obj.BackgroundColor3 == oldField then
                    obj.BackgroundColor3 = FIELD
                elseif obj.BackgroundColor3 == oldAccent then
                    obj.BackgroundColor3 = ACCENT
                elseif obj.BackgroundColor3 == oldBG then
                    obj.BackgroundColor3 = BG
                end
            end

            if obj:IsA("ScrollingFrame") then
                obj.ScrollBarImageColor3 = ACCENT
            end
        end
    end

    -- Theme background: use the theme asset when one exists; PURPLE uses a clean tinted fill.
    if selectedTheme and selectedTheme.asset and selectedTheme.asset ~= "" then
        bgImg.Image = selectedTheme.asset
        bgImg.ImageTransparency = 0.16
    else
        bgImg.Image = ""
        bgImg.ImageTransparency = 1
    end
    bgDark.BackgroundColor3 = BG:Lerp(Color3.new(0,0,0), 0.58)

    -- Header follows the active theme completely.
    headerBar.BackgroundColor3 = PANEL
    headerStroke.Color = outlineColor
    local activeThemeAsset = selectedTheme and selectedTheme.asset or LOGO_ID
    if headerACLeft:IsA("ImageLabel") then headerACLeft.Image = activeThemeAsset end
    if headerACRight:IsA("ImageLabel") then headerACRight.Image = activeThemeAsset end
    headerLogo.TextColor3 = fontColor
    headerWarning.TextColor3 = outlineColor:Lerp(fontColor, 0.35)
    headerBarShade.BackgroundColor3 = BG:Lerp(Color3.new(0,0,0), 0.25)

    headerTitle.TextColor3 = fontColor
    headerSubtitle.TextColor3 = outlineColor:Lerp(fontColor, 0.25)
    headerRightTitle.TextColor3 = fontColor
    headerRightSubtitle.TextColor3 = outlineColor:Lerp(fontColor, 0.25)

    -- Gradient stroke follows the active theme instead of staying purple.
    local c1 = outlineColor
    local c2 = accentColor
    local c3 = mainColor
    if wGradient then
        wGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c1),
            ColorSequenceKeypoint.new(0.5, c2),
            ColorSequenceKeypoint.new(1, c3)
        })
    end
    if iconGradient then
        iconGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c1),
            ColorSequenceKeypoint.new(0.5, c2),
            ColorSequenceKeypoint.new(1, c3)
        })
    end
end

