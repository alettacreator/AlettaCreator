-- =========================================================
-- SURVIVOR SAFETY / PALLET SYSTEM
-- Anti Block Window, Pallet Save Team, Safe Mode, Radius Pallet.
-- Semua fitur di bawah memakai objek runtime yang memang ada di map.
-- Tidak menebak payload remote baru.
-- =========================================================
local PalletSafety = {
    antiBlock = false,
    saveTeam = false,
    safeMode = true,
    radius = 12,
    connection = nil,
    windowParts = {},
    lastSave = 0,
    lastWindowRefresh = 0,
}

local function getPalletRadius()
    return math.clamp(tonumber(Values["Radius Pallet"]) or PalletSafety.radius or 12, 2, 40)
end

local function isStandingPallet(model)
    if not model or not model.Parent then return false end
    if model:GetAttribute("Dropped") == true then return false end
    if model:GetAttribute("IsDropped") == true then return false end
    if model:GetAttribute("Down") == true then return false end

    -- Beberapa build memakai state/boolean Value.
    for _, n in ipairs({"Dropped", "IsDropped", "Down", "Broken"}) do
        local v = model:FindFirstChild(n, true)
        if v and v:IsA("BoolValue") and v.Value then
            return false
        end
    end

    return true
end

local function palletPart(model)
    if not model then return nil end
    return model.PrimaryPart
        or model:FindFirstChild("PrimaryPartPallet", true)
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function nearestStandingPallet(maxDistance)
    local r = root()
    if not r then return nil end

    local best, bestDist = nil, maxDistance or math.huge
    for _, data in ipairs(getRuntimePallets()) do
        local model = data.model
        local part = data.part or palletPart(model)
        if model and part and model.Parent and isStandingPallet(model) then
            local d = (part.Position - r.Position).Magnitude
            if d <= bestDist then
                best, bestDist = model, d
            end
        end
    end
    return best, bestDist
end

local function getNearestTeammate(maxDistance)
    local r = root()
    if not r then return nil end

    local myRole = detectESPExplicitRole(player)
    local myTeam = player.Team and player.Team.Name
    local best, bestDist = nil, maxDistance or math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
            local ph = p.Character:FindFirstChildOfClass("Humanoid")
            if pr and ph and ph.Health > 0 then
                local sameTeam = false
                if player.Team and p.Team and player.Team == p.Team then
                    sameTeam = true
                elseif myTeam and p.Team and tostring(p.Team.Name) == tostring(myTeam) then
                    sameTeam = true
                else
                    local role = detectESPExplicitRole(p)
                    if myRole == "Survivor" and role == "Survivor" then
                        sameTeam = true
                    end
                end

                if sameTeam then
                    local d = (pr.Position - r.Position).Magnitude
                    if d <= bestDist then
                        best, bestDist = p, d
                    end
                end
            end
        end
    end
    return best, bestDist
end

local function killerNearPosition(position, radius)
    if not position then return nil end
    local best, bestDist = nil, radius or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and isKillerPlayer(p) then
            local c = p.Character
            local pr = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if pr and h and h.Health > 0 then
                local d = (pr.Position - position).Magnitude
                if d <= bestDist then
                    best, bestDist = p, d
                end
            end
        end
    end
    return best, bestDist
end

local function fireDropPalletAt(model)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local palletFolder = remotes and remotes:FindFirstChild("Pallet")
    local dropEvent = palletFolder and palletFolder:FindFirstChild("PalletDropEvent")
    if not (dropEvent and dropEvent:IsA("RemoteEvent")) then return false end
    if not (model and model.Parent) then return false end

    -- Payload yang sama dengan 1x Click Drop All Pallets.
    return pcall(function()
        dropEvent:FireServer(model)
    end)
end

local function runPalletSaveTeam()
    if not PalletSafety.saveTeam then return end
    if PalletSafety.safeMode ~= true then return end

    local now = os.clock()
    if now - PalletSafety.lastSave < 0.45 then return end

    local radius = getPalletRadius()
    local r = root()
    if not r then return end

    -- Safe Mode: hanya bekerja jika user sendiri berada dekat pallet.
    local pallet, palletDist = nearestStandingPallet(radius)
    if not pallet then return end

    local part = palletPart(pallet)
    if not part then return end

    -- Harus ada teammate dekat area pallet.
    local teammate = nil
    local teammateDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
            local ph = p.Character:FindFirstChildOfClass("Humanoid")
            if pr and ph and ph.Health > 0 then
                local sameTeam = (player.Team and p.Team and player.Team == p.Team)
                if not sameTeam then
                    local role = detectESPExplicitRole(p)
                    sameTeam = (role == "Survivor")
                end
                if sameTeam then
                    local d = (pr.Position - part.Position).Magnitude
                    if d <= radius and d < teammateDist then
                        teammate, teammateDist = p, d
                    end
                end
            end
        end
    end
    if not teammate then return end

    -- Killer harus benar-benar mendekati teammate/pallet agar pallet tidak
    -- terbuang sia-sia.
    local killer = killerNearPosition(teammate.Character.HumanoidRootPart.Position, radius * 1.5)
    if not killer then
        killer = killerNearPosition(part.Position, radius * 1.5)
    end
    if not killer then return end

    if fireDropPalletAt(pallet) then
        PalletSafety.lastSave = now
        print("[Aletta] Pallet Save Team: pallet dijatuhkan untuk teammate.")
    end
end

local function collectWindowParts()
    local map = getRuntimeMap()
    if not map then return {} end

    local results = {}
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            local parentName = obj.Parent and string.lower(obj.Parent.Name) or ""
            if n == "window" or n == "window_b" or n == "window_c"
                or n == "window_c_glass" or n:find("window_glass", 1, true)
                or n:find("window_pane", 1, true)
                or parentName == "window" or parentName == "vault" then
                table.insert(results, obj)
            end
        end
    end
    return results
end

local function restoreWindowCollision()
    for part, oldValue in pairs(PalletSafety.windowParts) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = oldValue
            end)
        end
    end
    table.clear(PalletSafety.windowParts)
end

local function updateAntiBlockWindow()
    if not PalletSafety.antiBlock then
        restoreWindowCollision()
        return
    end

    local r = root()
    if not r then return end

    local radius = getPalletRadius()
    local now = os.clock()
    if now - PalletSafety.lastWindowRefresh < 0.12 then return end
    PalletSafety.lastWindowRefresh = now

    -- Bersihkan cache part yang sudah hilang.
    for part in pairs(PalletSafety.windowParts) do
        if not part or not part.Parent then
            PalletSafety.windowParts[part] = nil
        end
    end

    for _, part in ipairs(collectWindowParts()) do
        if part and part.Parent then
            local d = (part.Position - r.Position).Magnitude
            if d <= radius then
                if PalletSafety.windowParts[part] == nil then
                    PalletSafety.windowParts[part] = part.CanCollide
                end
                -- Local anti-block: window/vault geometry tidak menahan
                -- collision client ketika player berada di area interaksi.
                pcall(function()
                    part.CanCollide = false
                end)
            elseif PalletSafety.windowParts[part] ~= nil then
                local old = PalletSafety.windowParts[part]
                PalletSafety.windowParts[part] = nil
                pcall(function()
                    part.CanCollide = old
                end)
            end
        end
    end
end

