local veilSnapPart, veilSnapTarget, veilSnapBeam
local function destroyVeilSnap()
    if veilSnapBeam then pcall(function() veilSnapBeam:Destroy() end) end
    if veilSnapPart then pcall(function() veilSnapPart:Destroy() end) end
    if veilSnapTarget then pcall(function() veilSnapTarget:Destroy() end) end
    veilSnapBeam,veilSnapPart,veilSnapTarget=nil,nil,nil
end

local function getVeilTarget()
    local myRoot=root(); camera=workspace.CurrentCamera or camera
    if not myRoot or not camera then return nil end
    local best,bestScore=nil,math.huge
    local maxDistance=math.clamp(tonumber(Values["Veil Distance"]) or 150,10,500)
    local fovRadius=math.clamp(tonumber(Values["Veil FOV Radius"]) or 120,10,600)
    local center=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
    for _,targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer~=player then
            local c=targetPlayer.Character; local h=c and c:FindFirstChildOfClass("Humanoid"); local r=c and getRootPart(c)
            if h and h.Health>0 and r and not isKnocked(c,targetPlayer) and detectESPExplicitRole(targetPlayer)=="Survivor" then
                local part=aimPartFor(c); local d=(r.Position-myRoot.Position).Magnitude
                if part and d<=maxDistance then
                    local vp,onScreen=camera:WorldToViewportPoint(part.Position)
                    if onScreen and vp.Z>0 then
                        local score=(Vector2.new(vp.X,vp.Y)-center).Magnitude
                        if score<=fovRadius and score<bestScore and hasLineOfSight(camera.CFrame.Position,part,c) then
                            bestScore=score; best={player=targetPlayer,character=c,root=r,part=part,distance=d}
                        end
                    end
                end
            end
        end
    end
    return best
end

local function getVeilPredictedPosition(target)
    if not target or not target.part then return nil end
    if not Values["Smart Predict Mode"] then return target.part.Position end
    local speed=math.max(tonumber(Values["Spear Speed"]) or 165,1)
    local lead=math.clamp((tonumber(Values["Smart Predict Lead"]) or 17)/100,0,1.5)
    local velocity=target.part.AssemblyLinearVelocity or target.root.AssemblyLinearVelocity or Vector3.zero
    local flight=math.clamp((target.distance or 0)/speed,0,2)
    return target.part.Position+velocity*flight*lead
end

local function updateVeilSnap(target,pos)
    if not Values["Snapline"] or not target or not pos or not camera then destroyVeilSnap(); return end
    if not veilSnapBeam then
        veilSnapPart=Instance.new("Part"); veilSnapPart.Name="AlettaVeilSnapOrigin"; veilSnapPart.Anchored=true; veilSnapPart.CanCollide=false; veilSnapPart.CanTouch=false; veilSnapPart.CanQuery=false; veilSnapPart.Transparency=1; veilSnapPart.Size=Vector3.new(.1,.1,.1); veilSnapPart.Parent=workspace
        veilSnapTarget=Instance.new("Part"); veilSnapTarget.Name="AlettaVeilSnapTarget"; veilSnapTarget.Anchored=true; veilSnapTarget.CanCollide=false; veilSnapTarget.CanTouch=false; veilSnapTarget.CanQuery=false; veilSnapTarget.Transparency=1; veilSnapTarget.Size=Vector3.new(.1,.1,.1); veilSnapTarget.Parent=workspace
        local a=Instance.new("Attachment",veilSnapPart); local b=Instance.new("Attachment",veilSnapTarget)
        veilSnapBeam=Instance.new("Beam"); veilSnapBeam.Attachment0=a; veilSnapBeam.Attachment1=b; veilSnapBeam.FaceCamera=true; veilSnapBeam.Width0=.025; veilSnapBeam.Width1=.025; veilSnapBeam.Color=ColorSequence.new(ACCENT); veilSnapBeam.Parent=veilSnapPart
    end
    veilSnapPart.CFrame=CFrame.new(camera.CFrame.Position); veilSnapTarget.CFrame=CFrame.new(pos)
end

Hooks["Veil"] = function(on)
    disconnectList("Veil Auto Aim")
