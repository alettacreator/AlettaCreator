-- Verifikasi dilakukan melalui ServerScriptService bridge:
-- ReplicatedStorage/AlettaCreatorRemotes/VerifyKey
-- Server bridge meneruskan key + HWID ke API Vercel dan menambahkan UserId.
-- Isi API URL hanya di ServerScript, BUKAN di LocalScript.
--
-- Catatan keamanan:
-- Gate GUI berada di client sehingga bukan anti-tamper. Validasi server/API
-- adalah source of truth untuk akses key. Jangan taruh ADMIN_TOKEN di sini.

local AlettaKeyInfo = {
    valid = false,
    type = "UNKNOWN",
    expiresAt = nil,
    key = nil
}

local function formatExpiry(iso)
    if not iso or tostring(iso) == "" then
        return "Tidak diketahui"
    end
    local t = os.time({
        year = tonumber(string.sub(iso, 1, 4)),
        month = tonumber(string.sub(iso, 6, 7)),
        day = tonumber(string.sub(iso, 9, 10)),
        hour = tonumber(string.sub(iso, 12, 13)) or 0,
        min = tonumber(string.sub(iso, 15, 16)) or 0,
        sec = tonumber(string.sub(iso, 18, 19)) or 0
    })
    if not t then
        return tostring(iso)
    end
    return os.date("%d/%m/%Y %H:%M:%S", t)
end

local function getClientIdentifier()
    local ok, service = pcall(function()
        return game:GetService("RbxAnalyticsService")
    end)
    if ok and service then
        local ok2, id = pcall(function()
            return service:GetClientId()
        end)
        if ok2 and id and tostring(id) ~= "" then
            return tostring(id)
        end
    end
    -- Fallback hanya sebagai identifier sesi; bukan HWID hardware asli.
    return "SESSION-" .. tostring(player.UserId) .. "-" .. tostring(game.PlaceId)
end

local function keyGateNew(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        pcall(function() obj[k] = v end)
    end
    if parent then obj.Parent = parent end
    return obj
end

local function keyGateCorner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = object
    return c
end

local function makeKeyGate()
    local gate = keyGateNew("ScreenGui", {
        Name = "AlettaPremiumKey",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 10000,
        ZIndexBehavior = Enum.ZIndexBehavior.Global
    }, playerGui)

    local backdrop = keyGateNew("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(7, 4, 12),
        BackgroundTransparency = 0.08
    }, gate)

    local card = keyGateNew("Frame", {
        Size = UDim2.fromOffset(390, 300),
        Position = UDim2.new(0.5, -195, 0.5, -150),
        BackgroundColor3 = Color3.fromRGB(18, 12, 28),
        BorderSizePixel = 0
    }, backdrop)
    keyGateCorner(card, 14)

    local stroke = keyGateNew("UIStroke", {
        Color = Color3.fromRGB(150, 80, 255),
        Thickness = 2
    }, card)

    keyGateNew("TextLabel", {
        Size = UDim2.new(1, -32, 0, 34),
        Position = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1,
        Text = "ALETTA CREATOR V15",
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left
    }, card)

    keyGateNew("TextLabel", {
        Size = UDim2.new(1, -32, 0, 28),
        Position = UDim2.fromOffset(16, 52),
        BackgroundTransparency = 1,
        Text = "Masukkan Key untuk membuka Creator",
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Color3.fromRGB(190, 180, 205),
        TextXAlignment = Enum.TextXAlignment.Left
    }, card)

    local input = keyGateNew("TextBox", {
        Size = UDim2.new(1, -32, 0, 46),
        Position = UDim2.fromOffset(16, 92),
        BackgroundColor3 = Color3.fromRGB(38, 30, 54),
        BorderSizePixel = 0,
        PlaceholderText = "ALETTA-PREM3D-XXXXXX-XXXXXX-XXXXXX",
        PlaceholderColor3 = Color3.fromRGB(125, 115, 140),
        Text = "",
        ClearTextOnFocus = false,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Color3.new(1, 1, 1)
    }, card)
    keyGateCorner(input, 8)

    local verify = keyGateNew("TextButton", {
        Size = UDim2.new(1, -32, 0, 44),
        Position = UDim2.fromOffset(16, 148),
        BackgroundColor3 = Color3.fromRGB(150, 80, 255),
        BorderSizePixel = 0,
        Text = "VERIFY KEY",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Color3.new(1, 1, 1),
        AutoButtonColor = true
    }, card)
    keyGateCorner(verify, 8)

    local status = keyGateNew("TextLabel", {
        Size = UDim2.new(1, -32, 0, 54),
        Position = UDim2.fromOffset(16, 204),
        BackgroundTransparency = 1,
        Text = "Menghubungkan ke Key System...",
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextWrapped = true,
        TextColor3 = Color3.fromRGB(190, 180, 205),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top
    }, card)

    local remoteFolder = ReplicatedStorage:WaitForChild("AlettaCreatorRemotes", 15)
    local verifyRemote = remoteFolder and remoteFolder:FindFirstChild("VerifyKey")
    if not verifyRemote or not verifyRemote:IsA("RemoteFunction") then
        status.Text = "ERROR: VerifyKey tidak ditemukan. Pasang AlettaKeyServer di ServerScriptService."
        verify.Active = false
        verify.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        return gate, nil, nil
    end

    local function verifyKey()
        if verify:GetAttribute("Busy") then return end
        local key = tostring(input.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if key == "" then
            status.Text = "Masukkan Key terlebih dahulu."
            return
        end

        verify:SetAttribute("Busy", true)
        verify.Text = "CHECKING..."
        verify.Active = false
        status.Text = "Memeriksa Key, UserId dan device binding..."

        local ok, result = pcall(function()
            return verifyRemote:InvokeServer({
                key = key,
                hwid = getClientIdentifier()
            })
        end)

        if ok and type(result) == "table" and result.success then
            AlettaKeyInfo.valid = true
            AlettaKeyInfo.type = tostring(result.type or "UNKNOWN")
            AlettaKeyInfo.expiresAt = result.expiresAt
            AlettaKeyInfo.key = key
            status.Text = "KEY VALID\n" ..
                "Type: " .. AlettaKeyInfo.type ..
                "\nExpired: " .. formatExpiry(AlettaKeyInfo.expiresAt)
            task.wait(0.55)
            gate:Destroy()
            return true
        end

        local err = type(result) == "table" and tostring(result.error or "VERIFY_FAILED") or "VERIFY_FAILED"
        status.Text = "Key ditolak: " .. err
        verify.Text = "VERIFY KEY"
        verify.Active = true
        verify:SetAttribute("Busy", false)
        return false
    end

    verify.Activated:Connect(verifyKey)
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then verifyKey() end
    end)

    return gate, verifyKey, status
end

local keyGate, verifyKeyNow = makeKeyGate()
if not verifyKeyNow then
    warn("[Aletta Creator V15] Key bridge belum tersedia.")
    return
end

