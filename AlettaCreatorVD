end

local function startKillerAttackLoop()
    stopKillerAttackLoop()
    KillerRuntime.attackConn = FeatureManager:Connect("Auto Attack (No Animation)", RunService.Heartbeat, function()
        local range = math.max(1, tonumber(Values["Attack Range (studs)"]) or 12)
        local target, dist = nearestSurvivor(range)
        if not target then return end
