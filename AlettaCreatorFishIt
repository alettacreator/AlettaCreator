    local target = State.SelectedIsland

    if not target or target == "" then
        return
    end

    local found

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower() == target:lower() then
            found = obj
            break
        end
    end

    if not found then
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find(target:lower(),1,true) then
