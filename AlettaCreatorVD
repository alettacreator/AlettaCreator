-- ESP sengaja tidak aktif di lobby/intermission.
-- Game.VD menyediakan BindableEvent Start/endgame/RoundEnd yang dipakai
-- sebagai sinyal match. Jika script dimuat di tengah match, heuristic
-- di bawah mencari Role yang benar-benar diberikan ke player + object map.
local espMatchActive = false
local espMatchConnections = {}
local espLastKnownState = false
local espWaitingForStart = false
local clearESP
local rebuildESP
local heuristicCacheTime = 0
local heuristicCacheResult = false

local function disconnectESPMatchSignals()
    for _, connection in ipairs(espMatchConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(espMatchConnections)
end

local function setESPMatchActive(active)
    active = active == true
    espMatchActive = active
    espLastKnownState = active
    espWaitingForStart = not active
    if not active and clearESP then
        clearESP()
    elseif active and Values["Enable ESP"] and rebuildESP then
        task.defer(rebuildESP)
    end
end

local function findGameFolder()
    local replicated = game:GetService("ReplicatedStorage")
    local remotes = replicated:FindFirstChild("Remotes")
    if not remotes then return nil end
    return remotes:FindFirstChild("Game")
end

local function bindMatchSignals()
    disconnectESPMatchSignals()
    local gameFolder = findGameFolder()
    if not gameFolder then return end

    local startEvent = gameFolder:FindFirstChild("Start")
    local endEvent = gameFolder:FindFirstChild("endgame")
    local roundEndEvent = gameFolder:FindFirstChild("RoundEndEvent")
    local roundEnd = gameFolder:FindFirstChild("RoundEnd")
    local endScreen = gameFolder:FindFirstChild("EndScreenEvent")

    if startEvent and startEvent:IsA("BindableEvent") then
        table.insert(espMatchConnections, startEvent.Event:Connect(function()
            setESPMatchActive(true)
        end))
    end

    for _, event in ipairs({endEvent, roundEndEvent, roundEnd, endScreen}) do
        if event and event:IsA("BindableEvent") then
            table.insert(espMatchConnections, event.Event:Connect(function()
                setESPMatchActive(false)
            end))
        end
    end
end

