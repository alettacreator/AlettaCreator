local function MakeToggle(parent,data)

	local row = New("Frame",{
		Size = UDim2.new(1,-8,0,31),
		BackgroundColor3 = Color3.fromRGB(14,7,24),
		BackgroundTransparency = .18,
	},parent)

	Corner(row,7)

	local label = New("TextLabel",{
		Text = data[1],
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(235,235,240),
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8,0),
		Size = UDim2.new(1,-55,1,0),
		TextXAlignment = Enum.TextXAlignment.Left,
	},row)

	local button = New("TextButton",{
		Text = "",
		BackgroundColor3 = Color3.fromRGB(75,75,82),
		Position = UDim2.new(1,-42,.5,-9),
		Size = UDim2.fromOffset(34,18),
		AutoButtonColor = false,
	},row)

	Corner(button,10)

	local knob = New("Frame",{
		Size = UDim2.fromOffset(14,14),
		Position = UDim2.fromOffset(2,2),
		BackgroundColor3 = Color3.new(1,1,1),
	},button)

	Corner(knob,8)

	local enabled = data[3] == true

	local function refresh()
		button.BackgroundColor3 =
			enabled and GetTheme().accent
			or Color3.fromRGB(75,75,82)

		knob.Position =
			enabled
			and UDim2.new(1,-16,0,2)
			or UDim2.fromOffset(2,2)
	end

	refresh()

	button.MouseButton1Click:Connect(function()
		enabled = not enabled
		refresh()
	end)

	return row
end

