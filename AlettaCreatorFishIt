local HiddenCache = {}

local function setPlayerVisible(plr,visible)
    if plr == LocalPlayer then
        return
    end

    local char = plr.Character

    if not char then
        return
    end

    for _,obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if not visible then
                HiddenCache[obj] = obj.LocalTransparencyModifier
                obj.LocalTransparencyModifier = 1
            else
                obj.LocalTransparencyModifier = HiddenCache[obj] or 0
                HiddenCache[obj] = nil
            end
        elseif obj:IsA("Decal") then
            if not visible then
                HiddenCache[obj] = obj.Transparency
                obj.Transparency = 1
            else
                obj.Transparency = HiddenCache[obj] or 0
                HiddenCache[obj] = nil
            end
        end
    end
end

