-- TOGGLE
--========================================================--

local function Toggle(parent,text,default)

    local state = default or false

    local row = Create("Frame",{
        Size = UDim2.new(1,0,0,43),

        BackgroundColor3 = Color3.fromRGB(30,13,42),

        BackgroundTransparency = .18,

        BorderSizePixel = 0,

        ZIndex = 6
    },parent)

    Round(row,7)

    Create("TextLabel",{
        Position = UDim2.fromOffset(14,0),

        Size = UDim2.new(1,-80,1,0),

        BackgroundTransparency = 1,

        Text = text,

        TextColor3 = Text,

        Font = Enum.Font.Gotham,

        TextSize = 11,

        TextXAlignment = Enum.TextXAlignment.Left,

        ZIndex = 8
    },row)

    local switch = Create("TextButton",{
        Size = UDim2.fromOffset(49,25),

        Position = UDim2.new(1,-62,.5,-12),

        BackgroundColor3 =
            Color3.fromRGB(55,40,65),

        Text = "",

        AutoButtonColor = false,

        ZIndex = 8
    },row)

    Round(switch,15)

    local knob = Create("Frame",{
        Size = UDim2.fromOffset(19,19),

        Position = UDim2.fromOffset(3,3),

        BackgroundColor3 =
            Color3.fromRGB(205,195,210),

        BorderSizePixel = 0,

        ZIndex = 9
    },switch)

    Round(knob,20)

    local function Update()

        if state then

            Tween(switch,{
                BackgroundColor3 = Accent
            },.15)

            Tween(knob,{
                Position =
                    UDim2.new(1,-22,0,3),
                BackgroundColor3 =
                    Color3.new(1,1,1)
            },.15)

        else

            Tween(switch,{
                BackgroundColor3 =
                    Color3.fromRGB(55,40,65)
            },.15)

            Tween(knob,{
                Position =
                    UDim2.fromOffset(3,3),
                BackgroundColor3 =
                    Color3.fromRGB(205,195,210)
            },.15)

        end

    end

    switch.MouseButton1Click:Connect(function()

        state = not state

        Update()

    end)

    Update()

    return row

end

