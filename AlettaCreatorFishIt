local function GetPlayers()
    local list = {}

    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list,p.Name)
        end
    end

    if #list == 0 then
        table.insert(list,"No Player")
    end

    return list
end

