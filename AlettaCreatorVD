local CONFIG_FILE = "AlettaCreator_Config.json"
local function canFileRead() return type(readfile)=="function" and type(isfile)=="function" end
local function canFileWrite() return type(writefile)=="function" end
local function encodeValue(v)
    local tv=typeof(v)
    if tv=="EnumItem" then return {__enum=tostring(v.EnumType),name=v.Name}
    if tv=="Color3" then return {__color3=true,r=v.R,g=v.B,b=v.B} end
    if type(v)=="table" then
        local t={}
        for k,x in pairs(v) do
            local ex=encodeValue(x)
            if ex~=nil then t[k]=ex end
        end
        return t
    end
    if type(v)=="string" or type(v)=="number" or type(v)=="boolean" then return v end
    return nil
end
local function decodeValue(v)
    if type(v)~="table" then return v end
    if v.__color3 then return Color3.new(tonumber(v.r) or 0,tonumber(v.g) or 0,tonumber(v.b) or 0) end
    if v.__enum then
        local et=v.__enum:gsub("Enum%.?","")
        local ok,en=pcall(function() return Enum[et] end)
        if ok and en and en[v.name] then return en[v.name] end
        return v.name
    end
    local t={}; for k,x in pairs(v) do t[k]=decodeValue(x) end; return t
end
local function configSnapshot()
    local snapshot={}
    -- Simpan hanya control yang benar-benar ada di GUI, bukan runtime objects.
    for key in pairs(Controls) do
        local v=encodeValue(Values[key])
        if v~=nil then snapshot[key]=v end
    end
    return snapshot
end
local function savePersistentConfig(name,snapshot)
    if not canFileWrite() then return false end
    local ok,json=pcall(function() return HttpService:JSONEncode({version=2,configs={[name]=snapshot}}) end)
    if not ok then return false end
    local old={}
    if canFileRead() and isfile(CONFIG_FILE) then
        local rok,r=pcall(readfile,CONFIG_FILE); if rok then local dok,d=pcall(HttpService.JSONDecode,HttpService,r); if dok and type(d)=="table" then old=d end end
    end
    old.version=2; old.configs=old.configs or {}; old.configs[name]=snapshot
    local wok,w=pcall(function() return HttpService:JSONEncode(old) end)
    if wok then return pcall(writefile,CONFIG_FILE,w) end
    return false
end
local function loadPersistentConfigs()
    if not (canFileRead() and isfile(CONFIG_FILE)) then return end
    local ok,data=pcall(readfile,CONFIG_FILE); if not ok then return end
    local dok,obj=pcall(HttpService.JSONDecode,HttpService,data)
    if not dok or type(obj)~="table" or type(obj.configs)~="table" then return end
    for name,snap in pairs(obj.configs) do sessionConfigs[name]=snap end
end
local function applySnapshot(snapshot)
    if type(snapshot)~="table" then return end
    for key, raw in pairs(snapshot) do
        local value=decodeValue(raw)
        local control=Controls[key]
        if control and control.set then pcall(function() control.set(value) end) else Values[key]=value end
    end
    applyConfigVisuals()
end
local function configNames()
    local names={}; for name in pairs(sessionConfigs) do table.insert(names,name) end
    table.sort(names); if #names==0 then names[1]="No Config" end; return names
end
local function refreshConfigDropdown(selected)
    local list=configNames(); local current=selected or Values["Config List"]
    if not sessionConfigs[current] and current~="No Config" then current=list[1] end
    Values["Config List"]=current
    local control=Controls["Config List"]
    if control and control.setOptions then control.setOptions(list,current) elseif control and control.set then control.set(current) end
    return list
end
