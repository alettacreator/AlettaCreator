local function runV14()
    status.Text = "Key valid. Mengambil Aletta Creator..."
    task.wait(0.25)

    local okFetch, source = pcall(function()
        return game:HttpGet(V14_RAW_URL, true)
    end)

    if not okFetch or type(source) ~= "string" or #source < 1000 then
        busy = false
        verify.Active = true
        verify.Text = "VERIFY KEY"
        status.Text = "V14 gagal diambil.\nPastikan file Aletta_Creator_V14_RAW.lua sudah di-upload ke GitHub."
        return
    end

    local compiler = loadstring
    if type(compiler) ~= "function" then
        busy = false
        verify.Active = true
        verify.Text = "VERIFY KEY"
        status.Text = "Executor tidak menyediakan loadstring."
        return
    end

    local okCompile, chunk = pcall(function()
        return compiler(source, "AlettaCreator_V14")
    end)

    if not okCompile or type(chunk) ~= "function" then
        busy = false
        verify.Active = true
        verify.Text = "VERIFY KEY"
        status.Text = "V14 gagal dikompilasi.\n" .. tostring(chunk)
        return
    end

    gui:Destroy()

    local okRun, err = xpcall(chunk, function(e)
        return debug and debug.traceback and debug.traceback(tostring(e), 2) or tostring(e)
    end)

    if not okRun then
        warn("[Aletta Creator V14 ERROR]\n" .. tostring(err))
        ENV.__ALETTA_V15_RUNNING = nil
    end
end

local function verifyKey()
    if busy then return end

    local key = trim(input.Text)
    if key == "" then
        status.Text = "Masukkan key terlebih dahulu."
        return
    end

    local req = getRequest()
    if type(req) ~= "function" then
        status.Text = "Executor tidak menyediakan request/http_request."
        return
    end

    busy = true
    verify.Active = false
    verify.Text = "CHECKING..."
    status.Text = "Menghubungkan ke Aletta API..."

    local body = HttpService:JSONEncode({
        key = key,
        userId = tostring(player.UserId),
        hwid = getHWID()
    })

    local ok, res = pcall(function()
        return req({
            Url = API_BASE .. "/api/verify",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body
        })
    end)

    if not ok or type(res) ~= "table" then
        busy = false
        verify.Active = true
        verify.Text = "VERIFY KEY"
        status.Text = "Request API gagal.\n" .. tostring(res or "unknown error")
        return
    end

    local raw = res.Body or res.body or ""
    local jsonOK, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not jsonOK or type(data) ~= "table" then
        busy = false
        verify.Active = true
        verify.Text = "VERIFY KEY"
        status.Text = "Response API tidak valid.\nHTTP: " ..
            tostring(res.StatusCode or res.status_code or "?")
        return
    end

    if data.success == true then
        ENV.__ALETTA_V15_KEY_VALID = true
        ENV.__ALETTA_V15_KEY_TYPE = tostring(data.type or "UNKNOWN")
        ENV.__ALETTA_V15_KEY_EXPIRES = data.expiresAt
        runV14()
        return
    end

    local e = tostring(data.error or "VERIFY_FAILED")
    local map = {
        KEY_NOT_FOUND = "Key tidak ditemukan.",
        KEY_REVOKED = "Key sudah direvoke.",
        KEY_EXPIRED = "Key sudah expired.",
        USER_MISMATCH = "Key terikat ke UserId lain.",
        HWID_MISMATCH = "Key terikat ke perangkat lain.",
        MISSING_FIELDS = "Data verifikasi tidak lengkap."
    }

    busy = false
    verify.Active = true
    verify.Text = "VERIFY KEY"
    status.Text = map[e] or ("Verifikasi gagal: " .. e)
end

verify.Activated:Connect(verifyKey)
getFree.Activated:Connect(openFree)
input.FocusLost:Connect(function(enterPressed)
    if enterPressed then verifyKey() end
end)

