-- AUTO PARRY - PROJECT-LOCAL IMPLEMENTATION
-- Uses the project's Parrying Dagger remote when it exists, with the normal
-- Tool:Activate() path. Cooldown is fixed at 120 seconds.
-- Radius is controlled by Survivor > Parry Menu > Parry Radius.
-- The detection visualization is a flat ground circle under the player's feet.

local AutoParry = { last=0, cooldown=120, armed=false, lastResult=0, resultSeen=false }

local function getRootPart(model)
    return model and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso"))
end

local function findRemotePath(names)
    local node=game:GetService("ReplicatedStorage")
    for _,name in ipairs(names) do node=node and node:FindFirstChild(name) end
    return node
end

local function findParryRemote()
    local rs=game:GetService("ReplicatedStorage")
    local r=findRemotePath({"Remotes","Items","Parrying Dagger","parry"})
    if r and r:IsA("RemoteEvent") then return r end
    for _,d in ipairs(rs:GetDescendants()) do
        if d:IsA("RemoteEvent") and string.lower(d.Name)=="parry" and d.Parent and string.lower(d.Parent.Name):find("parry") then return d end
    end
end
local function findParryResultRemote()
    local r=findRemotePath({"Remotes","Items","Parrying Dagger","parryResult"})
    return r and r:IsA("RemoteEvent") and r or nil
end
local function findParryTool()
    local function scan(c)
        if not c then return end
        for _,v in ipairs(c:GetChildren()) do
            if v:IsA("Tool") then
                local n=string.lower(v.Name)
                if n:find("parry") or n:find("dagger") then return v end
            end
        end
    end
    return scan(character()) or scan(player:FindFirstChildOfClass("Backpack"))
end
local function isKillerPlayer(p)
    if not p or p==player then return false end
    local c=p.Character
    local role=(c and (c:GetAttribute("Role") or c:GetAttribute("RoleName") or c:GetAttribute("Team"))) or p:GetAttribute("Role") or p:GetAttribute("RoleName")
    if typeof(role)=="string" and string.lower(role):find("killer") then return true end
    return p.Team and string.lower(p.Team.Name):find("killer")~=nil or false
end
local function attackTrackInfo(h)
    local best
    for _,t in ipairs(h:GetPlayingAnimationTracks()) do
        local n=string.lower(t.Name or "")
        local id=string.lower(t.Animation and t.Animation.AnimationId or "")
        if (n.." "..id):find("attack") or (n.." "..id):find("lunge") or (n.." "..id):find("slash") or (n.." "..id):find("swing") or (n.." "..id):find("m1") or (n.." "..id):find("m2") then
            local len=tonumber(t.Length) or 0; local pos=tonumber(t.TimePosition) or 0
            local progress=len>0 and pos/len or 1
            if not best or progress>best.progress then best={track=t,progress=progress,length=len} end
        end
    end
    return best
end
local function threatForKiller(p,myRoot,radius)
    if not isKillerPlayer(p) then return end
    local c=p.Character; local h=c and c:FindFirstChildOfClass("Humanoid"); local r=getRootPart(c)
    if not h or h.Health<=0 or not r then return end
    local delta=myRoot.Position-r.Position; local dist=delta.Magnitude
    if dist>radius then return end
    local toUs=dist>0 and delta.Unit or Vector3.zero
    local vel=r.AssemblyLinearVelocity; local speed=vel.Magnitude; local closing=vel:Dot(toUs)
    local facing=r.CFrame.LookVector:Dot(toUs)
    local attack=attackTrackInfo(h)
    local moving=speed>=7 and closing>=4
    if not attack and not moving then return end
    if facing < -0.35 and not moving then return end
    return {player=p,root=r,distance=dist,speed=speed,closing=closing,facing=facing,attack=attack}
end
local function getThreat()
    local mr=root(); if not mr then return end
    local radius=math.clamp(tonumber(Values["Parry Radius"]) or 13,2,100)
    if Values["Aggressive Parry"] then radius=math.max(radius,math.clamp(tonumber(Values["ESP Range"]) or radius,radius,60)) end
    local best
    for _,p in ipairs(Players:GetPlayers()) do
        local t=threatForKiller(p,mr,radius)
        if t and (not best or t.distance<best.distance) then best=t end
    end
    return best
end
local function sendParry()
    local now=os.clock()
    local remaining=AutoParry.cooldown-(now-AutoParry.last)
    if AutoParry.last>0 and remaining>0 then
        return false
    end

    local sent=false
    local h=humanoid()
    local tool=findParryTool()

    -- Satu trigger saja per siklus cooldown. Prioritaskan Tool:Activate()
    -- karena itu jalur aksi dagger yang paling dekat dengan gameplay normal.
    if tool and tool.Parent~=character() and h then
        pcall(function() h:EquipTool(tool) end)
        task.wait()
        tool=findParryTool()
    end

    if tool and tool.Parent==character() then
        local ok=pcall(function() tool:Activate() end)
        sent=ok
    else
        -- Fallback hanya jika Tool tidak tersedia.
        local remote=findParryRemote()
        if remote then
            local ok=pcall(function() remote:FireServer() end)
            sent=ok
        end
    end

    if sent then
        -- Mulai cooldown 120 detik segera setelah parry dikirim.
        AutoParry.last=os.clock()
    end
    return sent
end
local function stopAutoParry()
    disconnectList("Auto Parry"); disconnectList("Auto Parry Result"); AutoParry.armed=false
end
Hooks["Auto Parry"] = function(on)
    stopAutoParry(); setParryRangeVisual(on or Values["Safety Parry"] or Values["Aggressive Parry"])
    if not on then return end
    AutoParry.armed=true
    local result=findParryResultRemote()
    if result then FeatureManager:Connect("Auto Parry Result",result.OnClientEvent,function(...) AutoParry.lastResult=os.clock(); AutoParry.resultSeen=true end) end
    FeatureManager:Connect("Auto Parry",RunService.Heartbeat,function()
        if not AutoParry.armed then return end
        updateParryRangeVisual()
        local t=getThreat(); if not t then return end
        local radius=math.clamp(tonumber(Values["Parry Radius"]) or 13,2,100)
        local safety=Values["Safety Parry"]==true
        local aggressive=Values["Aggressive Parry"]==true
        local should=false
        if t.attack then
            local pr=t.attack.progress
            -- Trigger lebih awal agar tidak melewati white/perfect window.
            -- Normal/Legit: masuk fase wind-up sampai impact.
            -- Aggressive: mulai dari awal attack.
            if aggressive then
                should=pr>=.08 and pr<=.92
            else
                should=pr>=.20 and pr<=.96
            end
        end

        local closing=t.closing
        local reach=4.5
        local eta=closing>1 and math.max(0,(t.distance-reach)/closing) or math.huge

        -- Prioritaskan jarak impact. Ini membuat Auto Parry tidak hanya
        -- bergantung pada nama AnimationTrack.
        if eta<=.24 then
            should=true
        elseif aggressive and eta<=.45 then
            should=true
        end

        if safety and t.distance>radius then should=false end
        if aggressive and t.distance<=math.max(radius,tonumber(Values["ESP Range"]) or radius) then
            should=should or eta<=.55
        end

        if should then
            sendParry()
        end
    end)
end
