local ENV = {}
pcall(function()
    if type(getgenv) == "function" then ENV = getgenv()
    elseif type(shared) == "table" then ENV = shared end
end)

if ENV.__ALETTA_V15_RUNNING then return end
ENV.__ALETTA_V15_RUNNING = true

local function trim(s)
    return tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function getRequest()
    local candidates = {}
    local function add(f)
        if type(f) == "function" then table.insert(candidates, f) end
    end

    pcall(function() add(ENV.request) end)
    pcall(function() add(ENV.http_request) end)
    pcall(function() add(ENV.httprequest) end)
    pcall(function() if ENV.syn then add(ENV.syn.request) end end)
    pcall(function() if ENV.http then add(ENV.http.request) end end)

    return candidates[1]
end

local function getHWID()
    local fallback = "RBX-" .. tostring(player.UserId) .. "-" .. tostring(game.PlaceId)
    local ok, svc = pcall(function()
        return game:GetService("RbxAnalyticsService")
    end)
    if ok and svc then
        local ok2, id = pcall(function()
            return svc:GetClientId()
        end)
        if ok2 and id and tostring(id) ~= "" then
            return tostring(id)
        end
    end
    return fallback
end

