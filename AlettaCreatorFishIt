local function Toggle(parent, text, key)
    local holder = New("Frame", {
        Size = UDim2.new(1,0,0,40),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0
    }, parent)

    Corner(holder, 7)

    local label = New("TextLabel", {
        Size = UDim2.new(1,-65,1,0),
        Position = UDim2.fromOffset(12,0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = TEXT,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local button = New("TextButton", {
        Size = UDim2.fromOffset(42,22),
        Position = UDim2.new(1,-53,0.5,-11),
        BackgroundColor3 = FIELD,
        Text = "",
        AutoButtonColor = false
    }, holder)

    Corner(button, 12)

    local circle = New("Frame", {
        Size = UDim2.fromOffset(18,18),
        Position = UDim2.fromOffset(2,2),
        BackgroundColor3 = MUTED,
        BorderSizePixel = 0
    }, button)

    Corner(circle, 20)

    local function update()
        local on = State[key]

        button.BackgroundColor3 = on and Accent or FIELD
        circle.BackgroundColor3 = on and Color3.new(1,1,1) or MUTED
        circle.Position = on
            and UDim2.new(1,-20,0,2)
            or UDim2.fromOffset(2,2)
    end

    button.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        update()
    end)

    update()

    return holder
end

local function Input(parent, text, key, default)
    State[key] = default or State[key]

    local holder = New("Frame", {
        Size = UDim2.new(1,0,0,44),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0
    }, parent)

    Corner(holder, 7)

    New("TextLabel", {
        Size = UDim2.new(0.55,0,1,0),
        Position = UDim2.fromOffset(12,0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = TEXT,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local box = New("TextBox", {
        Size = UDim2.new(0.4,-10,0,28),
        Position = UDim2.new(0.6,0,0.5,-14),
        BackgroundColor3 = FIELD,
        Text = tostring(State[key]),
        TextColor3 = TEXT,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        ClearTextOnFocus = false
    }, holder)

    Corner(box, 5)

    box.FocusLost:Connect(function()
        local number = tonumber(box.Text)

        if number then
            State[key] = number
        else
            State[key] = box.Text
        end
    end)

    return holder
end

local function Dropdown(parent, text, key, values)
    local holder = New("Frame", {
        Size = UDim2.new(1,0,0,44),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0
    }, parent)

    Corner(holder, 7)

    New("TextLabel", {
        Size = UDim2.new(0.45,0,1,0),
        Position = UDim2.fromOffset(12,0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = TEXT,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local selected = values[1]
    State[key] = State[key] ~= "" and State[key] or selected

    local button = New("TextButton", {
        Size = UDim2.new(0.48,0,0,28),
        Position = UDim2.new(0.51,0,0.5,-14),
        BackgroundColor3 = FIELD,
        Text = tostring(State[key]) .. "  ▾",
        TextColor3 = TEXT,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        AutoButtonColor = false
    }, holder)

    Corner(button, 5)

    local popup

    button.MouseButton1Click:Connect(function()
        if popup then
            popup:Destroy()
            popup = nil
            return
        end

        popup = New("Frame", {
            Size = UDim2.new(0,180,0,math.min(#values*30+8,190)),
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0,
            ZIndex = 50
        }, GUI)

        Corner(popup, 6)
        Stroke(popup, Accent, 1)

        local abs = button.AbsolutePosition
        popup.Position = UDim2.fromOffset(abs.X, abs.Y + button.AbsoluteSize.Y + 3)

        local scroll = New("ScrollingFrame", {
            Size = UDim2.new(1,-8,1,-8),
            Position = UDim2.fromOffset(4,4),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ZIndex = 51
        }, popup)

        local layout = New("UIListLayout", {
            Padding = UDim.new(0,3)
        }, scroll)

        for _,value in ipairs(values) do
            local option = New("TextButton", {
                Size = UDim2.new(1,-4,0,27),
                BackgroundColor3 = FIELD,
                Text = tostring(value),
                TextColor3 = TEXT,
                Font = Enum.Font.Gotham,
                TextSize = 10,
                ZIndex = 52,
                AutoButtonColor = false
            }, scroll)

            Corner(option, 4)

            option.MouseButton1Click:Connect(function()
                State[key] = value
                button.Text = tostring(value) .. "  ▾"
                popup:Destroy()
                popup = nil
            end)
        end

        scroll.CanvasSize = UDim2.fromOffset(0,layout.AbsoluteContentSize.Y+5)
    end)

    return holder
end

local function Button(parent, text, callback)
    local b = New("TextButton", {
        Size = UDim2.new(1,0,0,40),
        BackgroundColor3 = FIELD,
        Text = text,
        TextColor3 = TEXT,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        AutoButtonColor = false
    }, parent)

    Corner(b, 7)

    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Accent
    end)

    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = FIELD
    end)

    b.MouseButton1Click:Connect(callback)

    return b
end

local function Label(parent, text)
    local l = New("TextLabel", {
        Size = UDim2.new(1,0,0,32),
        BackgroundColor3 = PANEL,
        Text = text,
        TextColor3 = MUTED,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextWrapped = true
    }, parent)

    Corner(l, 7)
    return l
end

