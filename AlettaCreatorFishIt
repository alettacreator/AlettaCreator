--// THEME ANIMATION
--//==================================================

task.spawn(function()
    local hue = 0

    while ScreenGui.Parent do
        task.wait(0.05)

        if CurrentTheme == "RAIMBOW" then
            hue += 0.003

            if hue > 1 then
                hue = 0
            end

            local rainbow = Color3.fromHSV(hue,0.75,1)

            WindowStroke.Color = rainbow
            MiniStroke.Color = rainbow
            Logo.TextColor3 = rainbow
            Mini.TextColor3 = rainbow
        end
    end
end)

