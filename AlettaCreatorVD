end

local function restoreLocalSpeed()
    local h = humanoid()
    if h then
        h.WalkSpeed = SurvivorRuntime.originalSpeed or originalWalkSpeed or 16
    end
end

local function healRemote(targetPlayer)
    local remote = getRemote("Remotes/Healing/HealEvent")
    if not (remote and remote:IsA("RemoteEvent")) then return false end

    -- Build project menggunakan HealEvent sebagai server-side healing
    -- entry point. Target player dikirim untuk team-heal; self-heal tidak
    -- membutuhkan target tambahan.
    if targetPlayer and targetPlayer ~= player then
        return pcall(function() remote:FireServer(targetPlayer) end)
    end
    return pcall(function() remote:FireServer() end)
end

local function findLowHealthTeammate(maxDistance)
    local r = root()
    if not r then return nil, math.huge end
    local best, bestDist, bestHealth = nil, math.huge, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and isAliveCharacter(p.Character) then
            local ph = p.Character:FindFirstChildOfClass("Humanoid")
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
            local same = player.Team and p.Team and player.Team == p.Team
            if not same then
                same = detectESPExplicitRole(p) == "Survivor"
            end
            if same and ph and pr and ph.Health < ph.MaxHealth then
                local d = (pr.Position - r.Position).Magnitude
                if d <= (maxDistance or 20) and (ph.Health < bestHealth or (ph.Health == bestHealth and d < bestDist)) then
                    best, bestDist, bestHealth = p, d, ph.Health
                end
            end
        end
    end
    return best, bestDist
end

local function getNearestTargetPartByName(names, maxDistance)
    local map = getRuntimeMap()
    local r = root()
    if not map or not r then return nil, math.huge end
    local best, bestDist = nil, maxDistance or math.huge
    for _, obj in ipairs(map:GetDescendants()) do
        local n = string.lower(obj.Name)
        local wanted = false
        for _, key in ipairs(names) do
            if n == string.lower(key) or n:find(string.lower(key), 1, true) then
                wanted = true
                break
            end
        end
        if wanted and obj:IsA("BasePart") then
            local d = (obj.Position - r.Position).Magnitude
            if d < bestDist then best, bestDist = obj, d end
        end
    end
    return best, bestDist
end

local function teleportToPart(part)
    local r = root()
    if not (r and part) then return false end
    if os.clock() - SurvivorRuntime.lastTeleport < 0.35 then return false end
    SurvivorRuntime.lastTeleport = os.clock()
    local ok = pcall(function()
        r.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    end)
    return ok
end

local function getTeleportTarget()
    local destination = tostring(Values["Teleport Destination"] or "Gate")
    local map = getRuntimeMap()
    if not map then return nil end

    if destination == "Teammate" then
        local p = getNearestTeammate(1000)
        local c = p and p.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    elseif destination == "Killer" then
        local p = nearestKiller(1000)
        local c = p and p.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    elseif destination == "Generator" then
        return getNearestTargetPartByName({"Generator"}, 1000)
    elseif destination == "Pallet" then
        local pallet = nearestStandingPallet(1000)
        return pallet and palletPart(pallet)
    elseif destination == "Hook" then
        return getNearestTargetPartByName({"Hook"}, 1000)
    else
        local _, part = getNearestExit()
        return part
    end
end

local function instantTeleport()
    local part = getTeleportTarget()
    if not part then
        warn("[Aletta] Teleport: target tidak ditemukan.")
        return
    end
    teleportToPart(part)
end

