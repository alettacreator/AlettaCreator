--//==================================================
--// SAFE FEATURE MANAGER
--//==================================================

local FeatureManager = {}
local Connections = {}

function FeatureManager:Set(name, enabled)
    State[name] = enabled

    if enabled then
        if self[name] then
            pcall(self[name])
        end
    end
end

function FeatureManager:Connect(name, signal, callback)
    if Connections[name] then
        Connections[name]:Disconnect()
    end

    Connections[name] = signal:Connect(callback)
end

function FeatureManager:Stop(name)
    if Connections[name] then
        Connections[name]:Disconnect()
        Connections[name] = nil
    end
end

function FeatureManager:StopAll()
    for name, connection in pairs(Connections) do
        connection:Disconnect()
        Connections[name] = nil
    end
end

