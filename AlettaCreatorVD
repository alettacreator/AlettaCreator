local function getRemote(path)
    local obj = ReplicatedStorage
    for part in string.gmatch(path, "[^/]+") do
        obj = obj and obj:FindFirstChild(part)
    end
    return obj
end

local function getHumanoidState()
    local h = humanoid()
    return h and h:GetState() or nil
end

local function isAliveCharacter(c)
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function nearestKiller(maxDistance)
    local r = root()
    if not r then return nil, math.huge end
    local best, bestDist = nil, maxDistance or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and isKillerPlayer(p) and p.Character and isAliveCharacter(p.Character) then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
            if pr then
                local d = (pr.Position - r.Position).Magnitude
                if d < bestDist then
                    best, bestDist = p, d
                end
            end
        end
    end
    return best, bestDist
end

local function setCrouch(state)
    local remote = getRemote("Remotes/Mechanics/Crouch")
    if not (remote and remote:IsA("RemoteEvent")) then return false end
    local ok = pcall(function()
