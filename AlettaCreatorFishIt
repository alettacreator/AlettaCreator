local function commit(label, value)
    Values[label] = value

    local hook = Hooks[label]
    if hook then
        task.spawn(function()
            local ok, err = pcall(hook, value)
            if not ok then
                warn("[Aletta] " .. tostring(label) .. ": " .. tostring(err))
            end
        end)
    end
end

local function makeControl(parent, control, order)
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundTransparency = 1,
        LayoutOrder = order
    }, parent)

    Controls[control.label] = Controls[control.label] or {}

    if control.type ~= "button"
        and control.type ~= "label"
        and control.type ~= "slider" then

        new("TextLabel", {
            Text = "   " .. control.label,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(220, 220, 220),
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -118, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true
        }, frame)
    end

    if control.type == "toggle" then
        local state = control.default == true
        Values[control.label] = state

        local switch = new("TextButton", {
            Text = "",
            Size = UDim2.fromOffset(40, 20),
            Position = UDim2.new(1, -52, 0.5, -10),
            AutoButtonColor = false,
            BackgroundColor3 = state and ACCENT or OFF
        }, frame)
        corner(switch, 10)

        local knob = new("Frame", {
            Size = UDim2.fromOffset(16, 16),
            Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2),
            BackgroundColor3 = TEXT
        }, switch)
        corner(knob, 8)

        local function setState(value, runHook)
            state = value == true

            TweenService:Create(
                switch,
                TweenInfo.new(0.15),
                {BackgroundColor3 = state and ACCENT or OFF}
            ):Play()

            TweenService:Create(
                knob,
                TweenInfo.new(0.15),
                {Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)}
            ):Play()

            Values[control.label] = state

            if runHook then
                commit(control.label, state)
            end
        end

        Controls[control.label].set = function(value)
            setState(value, true)
        end

        switch.Activated:Connect(function()
            setState(not state, true)
        end)

    elseif control.type == "input" then
        Values[control.label] = tonumber(control.default) or control.default

        local box = new("TextBox", {
            Text = control.default,
            PlaceholderText = control.placeholder or "",
            PlaceholderColor3 = Color3.fromRGB(140, 140, 140),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = TEXT,
            BackgroundColor3 = FIELD,
            Size = UDim2.fromOffset(96, 26),
            Position = UDim2.new(1, -106, 0.5, -13),
            ClearTextOnFocus = false,
            TextTruncate = Enum.TextTruncate.AtEnd
        }, frame)
        corner(box, 6)

        Controls[control.label].set = function(value)
            box.Text = tostring(value)
            commit(control.label, tonumber(value) or value)
        end

        box.FocusLost:Connect(function()
            commit(control.label, tonumber(box.Text) or box.Text)
        end)

    elseif control.type == "hotkey" then
        local keyName = tostring(control.default or "Unknown")
        local key = Enum.KeyCode[keyName] or Enum.KeyCode.Unknown
        Values[control.label] = key

        local button = new("TextButton", {
            Text = key.Name,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = TEXT,
            BackgroundColor3 = FIELD,
            Size = UDim2.fromOffset(96, 26),
            Position = UDim2.new(1, -106, 0.5, -13)
        }, frame)
        corner(button, 6)

        local listening = false

        button.Activated:Connect(function()
            if listening then return end

            listening = true
            button.Text = "..."

            local connection
            connection = UIS.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end

                if input.UserInputType == Enum.UserInputType.Keyboard then
                    button.Text = input.KeyCode.Name
                    commit(control.label, input.KeyCode)
                    listening = false

                    if connection then
                        connection:Disconnect()
                        connection = nil
                    end
                end
            end)
        end)

        Controls[control.label].set = function(value)
            local newKey

            if typeof(value) == "EnumItem" then
                newKey = value
            else
                newKey = Enum.KeyCode[tostring(value)] or Enum.KeyCode.Unknown
            end

            button.Text = newKey.Name
            commit(control.label, newKey)
        end

    elseif control.type == "dropdown" then
        Values[control.label] = control.default

        local button = new("TextButton", {
            Text = tostring(control.default),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = TEXT,
            BackgroundColor3 = FIELD,
